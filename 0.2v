pcall(function()
Window:OnDestroy(function()A:Stop()end)
end)

print("[AURORA HUB] 1 часть загружена")
print("[AURORA SOUND] Подключение:",A.SoundConnected)
local G=getgenv and getgenv() or _G
local A=G.AuroraHubV44

if not A or not A.Active or not A.Ready then
warn("[AURORA HUB] Сначала запусти часть 1")
return
end

if A.Part2Loaded then return end

local Window=A.Window
local C=A.C
local H=A.HC
local S=A.SC
local Registry=A.Registry

local legit=Window:Tab({Title="legit",Icon="crosshair"})
local rage=Window:Tab({Title="rage",Icon="zap"})
local visuals=Window:Tab({Title="visuals",Icon="eye"})
local movement=Window:Tab({Title="movement",Icon="footprints"})
local misc=Window:Tab({Title="misc",Icon="settings"})
local search=Window:Tab({Title="search",Icon="search"})

local function register(title,obj,tab)
Registry[#Registry+1]={title=title,obj=obj,tab=tab}
return obj
end

local function toggle(tab,title,value,callback)
return register(title,tab:Toggle({
Title=title,
Value=value,
Callback=callback
}),tab)
end

local function slider(tab,title,value,min,max,step,callback)
return register(title,tab:Slider({
Title=title,
Value={Min=min,Max=max,Default=value},
Step=step,
Callback=callback
}),tab)
end

local function dropdown(tab,title,values,value,callback)
return register(title,tab:Dropdown({
Title=title,
Values=values,
Value=value,
Callback=callback
}),tab)
end

legit:Section({Title="silent aim"})
toggle(legit,"silent aim",false,function()end)
slider(legit,"fov",100,0,500,1,function()end)

rage:Section({Title="ragebot"})
toggle(rage,"ragebot",false,function()end)
dropdown(rage,"hitbox",{"head","torso","random"},"head",function()end)

visuals:Section({Title="player esp"})

toggle(visuals,"Enabled",false,function(v)
C.enabled=v
end)

dropdown(visuals,"Box mode",{"corners","full"},C.mode,function(v)
if type(v)=="table" then v=v[1]end
if v=="corners" or v=="full" then C.mode=v end
end)

toggle(visuals,"Glow",false,function(v)
C.glow=v
end)

slider(visuals,"Glow transparency",C.glowTransparency,0,1,.01,function(v)
C.glowTransparency=v
end)

toggle(visuals,"Filled",false,function(v)
C.filled=v
end)

slider(visuals,"Filled transparency",C.filledTransparency,0,1,.01,function(v)
C.filledTransparency=v
end)

toggle(visuals,"Outline",false,function(v)
C.outline=v
end)

slider(visuals,"Outline transparency",C.outlineTransparency,0,1,.01,function(v)
C.outlineTransparency=v
end)

visuals:Section({Title="Health bar esp"})

toggle(visuals,"Enabled",false,function(v)
H.enabled=v
end)

toggle(visuals,"Health number",false,function(v)
H.number=v
end)

toggle(visuals,"Glow bar",false,function(v)
H.glow=v
end)

slider(visuals,"Glow transparency",H.glowTransparency,0,1,.01,function(v)
H.glowTransparency=v
end)

toggle(visuals,"Outline bar",false,function(v)
H.outline=v
end)

slider(visuals,"Outline transparency",H.outlineTransparency,0,1,.01,function(v)
H.outlineTransparency=v
end)

visuals:Section({Title="Sound render"})

toggle(visuals,"Sound ESP",false,function(v)
S.enabled=v
end)

slider(visuals,"Sound lifetime",S.life,1,6,.5,function(v)
S.life=v
end)


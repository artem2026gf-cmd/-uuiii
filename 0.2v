misc:Section({Title="misc"})
register("reload",misc:Button({
Title="reload",
Callback=function()end
}),misc)

search:Section({Title="Search settings"})

local query=""

search:Input({
Title="Search",
Placeholder="Type setting name...",
Callback=function(v)
query=tostring(v or ""):lower()
end
})

search:Button({
Title="Find and open",
Callback=function()
if query=="" then return end

for _,entry in ipairs(Registry)do
if entry.title:lower():find(query,1,true)then
pcall(function()Window:SelectTab(entry.tab)end)
pcall(function()entry.tab:Select()end)
pcall(function()
if entry.obj.ScrollTo then entry.obj:ScrollTo()end
end)
return
end
end

warn("[AURORA HUB] Настройка не найдена: "..query)
end
})


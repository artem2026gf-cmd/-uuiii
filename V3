        local paths={
            RS:FindFirstChild("GameTimer"),
            RS:FindFirstChild("RoundTimer"),
            RS:FindFirstChild("Timer"),
            W:FindFirstChild("GameTimer"),
            W:FindFirstChild("RoundTimer"),
            LP:FindFirstChild("PlayerGui") and LP.PlayerGui:FindFirstChild("Timer")
        }
        for _,p in ipairs(paths) do
            if p and p:IsA("NumberValue") or (p and p:IsA("StringValue")) then

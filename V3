local CFG={Enabled=true,FOV=180,MaxDist=2000,TeamCheck=true,DrawFov=false,FovColor=Color3.fromRGB(255,80,120),DeathCheck=true,TargetPart={"Head"},HistoryMode="backtrack",HistoryMaxAge=1,UseRealRaycast=true,AutoShoot=true,AutoShootDelay=0.05,VisibleOnly=true,MaxWallThickness=0.4,Debug=false}
local function log(...) if CFG.Debug then print("[amod]",...) end end
local function hasVest(c) if not c then return false end local a=c:FindFirstChild("CharacterArmor") return a and a:FindFirstChild("VestDetails")~=nil end
local function isEnemy(pl,ch)
    if not CFG.TeamCheck then return true end
    local me=LP.Character
    if not me then return false end
    local mv,hv=hasVest(me),hasVest(ch)
    if mv~=hv then return true end
    if not mv and not hv then
        local mt=LP:GetAttribute("Team") or (LP.Team and LP.Team.Name)
        local ht=pl and (pl:GetAttribute("Team") or (pl.Team and pl.Team.Name))
        if mt and ht and mt~=ht then return true end
    end
    return false
end
local function isAlive(c)
    if not c or not c.Parent then return false end
    if not CFG.DeathCheck then return true end
    if c:GetAttribute("Dead")==true then return false end
    local hp=c:GetAttribute("Health")
    if type(hp)=="number" and hp<=0 then return false end
    local hu=c:FindFirstChildOfClass("Humanoid")
    if hu and (hu.Health<=0 or hu:GetState()==Enum.HumanoidStateType.Dead) then return false end
    return c:FindFirstChild("Head")~=nil
end
local function isTree(obj)
    if not obj then return false end
    local n=obj.Name:lower()
    if n:find("tree") or n:find("wood") or n:find("leaf") or n:find("branch") or n:find("trunk") or n:find("bush") or n:find("plant") or n:find("forest") or n:find("log") or n:find("pine") or n:find("oak") or n:find("birch") then return true end
    local p=obj.Parent
    if p then local pn=p.Name:lower() if pn:find("tree") or pn:find("wood") or pn:find("forest") or pn:find("nature") then return true end end
    return false
end
local visRP=RaycastParams.new()
visRP.FilterType=Enum.RaycastFilterType.Exclude
visRP.IgnoreWater=true
local function canSeePart(part)
    if not part or not part.Parent then return false end
    local mc=LP.Character
    visRP.FilterDescendantsInstances=mc and {mc} or {}
    local origin=Cam.CFrame.Position
    local target=part.Position
    local delta=target-origin
    local dist=delta.Magnitude
    if dist<=0 then return true end
    local dir=delta.Unit
    local tModel=part:FindFirstAncestorOfClass("Model")
    local hit=W:Raycast(origin,delta,visRP)
    if not hit then return true end
    if isTree(hit.Instance) then
        local nearPos=hit.Position
        local startP=nearPos+dir*0.001
        local remain=dist-(startP-origin).Magnitude
        if remain<=0 then return false end
        local hit2=W:Raycast(startP,dir*remain,visRP)
        if not hit2 then return true end
        local h2Model=hit2.Instance:FindFirstAncestorOfClass("Model")
        if h2Model==tModel or hit2.Instance==part then return true end
        if h2Model and P:GetPlayerFromCharacter(h2Model) then return true end
        if isTree(hit2.Instance) then return true end
        return false
    end
    local hModel=hit.Instance:FindFirstAncestorOfClass("Model")
    if hModel==tModel or hit.Instance==part then return true end
    if hModel and P:GetPlayerFromCharacter(hModel) then return true end
    local nearPos=hit.Position
    local startP=nearPos+dir*0.001
    local remain=dist-(startP-origin).Magnitude
    if remain<=0 then return false end
    local hit2=W:Raycast(startP,dir*remain,visRP)
    if not hit2 then return false end
    local h2Model=hit2.Instance:FindFirstAncestorOfClass("Model")
    if not (h2Model==tModel or hit2.Instance==part) then return false end
    return (hit2.Position-nearPos).Magnitude<=CFG.MaxWallThickness
end
local GetRI,RCast,RCastThr
local function loadRaycastMods()
    pcall(function() GetRI=require(RS.Components.Common.GetRayIgnore) end)
    pcall(function() local RC=require(RS.Shared.Raycast) RCast=RC.cast RCastThr=RC.castThrough end)
end
loadRaycastMods()
local GROUPS={Torso={"UpperTorso","LowerTorso","HumanoidRootPart"},LeftArm={"LeftUpperArm","LeftLowerArm","LeftHand"},RightArm={"RightUpperArm","RightLowerArm","RightHand"},LeftLeg={"LeftUpperLeg","LeftLowerLeg","LeftFoot"},RightLeg={"RightUpperLeg","RightLowerLeg","RightFoot"},Head={"Head"}}
local function getPartList(t)
    if typeof(t)=="table" then local l={} for _,x in ipairs(t) do if GROUPS[x] then for _,p in ipairs(GROUPS[x]) do table.insert(l,p) end else table.insert(l,x) end end return l end
    if GROUPS[t] then return GROUPS[t] end
    return {"Head"}
end
local function pickPart(ch,cursor)
    local list=getPartList(CFG.TargetPart)
    local bestD,bestP=math.huge,nil
    for _,n in ipairs(list) do
        local p=ch:FindFirstChild(n)
        if p and p:IsA("BasePart") then
            if cursor then
                local sp=Cam:WorldToViewportPoint(p.Position)
                local d=(Vector2.new(sp.X,sp.Y)-cursor).Magnitude
                if d<bestD then bestD=d bestP=p end
            elseif not bestP then bestP=p end
        end
    end
    return bestP
end
local CHARS=W:FindFirstChild("Characters")
local hist={}
local function recordHistory(player,model)
    local entry=hist[player.Name] if not entry then entry={} hist[player.Name]=entry end
    local snap={}
    for _,part in ipairs(model:GetChildren()) do if part:IsA("BasePart") then snap[part.Name]=part.CFrame end end
    local root=model:FindFirstChild("HumanoidRootPart")
    table.insert(entry,{t=os.clock(),parts=snap,vel=root and root.AssemblyLinearVelocity or Vector3.zero})
    local cutoff=os.clock()-CFG.HistoryMaxAge
    while #entry>0 and entry[1].t<cutoff do table.remove(entry,1) end
end
local function backtrack(player)
    local entry=hist[player.Name] if not entry or #entry==0 then return nil end
    local ping=math.clamp(LP:GetNetworkPing(),0.05,1)
    local tt=os.clock()-ping
    local best=entry[1]
    for i=#entry,1,-1 do if entry[i].t<=tt then best=entry[i] break end end
    return best
end
local function forwardtrack(player)
    local entry=hist[player.Name] if not entry or #entry==0 then return nil end
    local last=entry[#entry]
    local ping=math.clamp(LP:GetNetworkPing(),0,0.3)
    local off=last.vel*ping
    local parts={} for k,cf in pairs(last.parts) do parts[k]=cf+off end return parts
end
local function getHistoricalPosition(player,partName)
    if CFG.HistoryMode=="forwardtrack" then
        local parts=forwardtrack(player) if not parts then return nil end
        local cf=parts[partName] or parts.Head or parts.HumanoidRootPart return cf and cf.Position or nil
    end
    local entry=backtrack(player) if not entry then return nil end
    local cf=entry.parts[partName] or entry.parts.Head or entry.parts.HumanoidRootPart
    return cf and cf.Position or nil
end
local function scaleHitPart(part,cursor,sc)
    if not part then return nil end
    local s=math.clamp(sc or 0,0,100)/100
    if s<=0 then return part.Position end
    local ray=Cam:ViewportPointToRay(cursor.X,cursor.Y)
    local cf=part.CFrame local half=part.Size/2
    local lp=cf:PointToObjectSpace(ray.Origin+ray.Direction*(part.Position-Cam.CFrame.Position).Magnitude)
    local cl=Vector3.new(math.clamp(lp.X,-half.X,half.X),math.clamp(lp.Y,-half.Y,half.Y),math.clamp(lp.Z,-half.Z,half.Z))
    return part.Position:Lerp(cf:PointToWorldSpace(cl),s)
end
local CurCh,CurPart,CurPos=nil,nil,nil
local function getAng(p)
    local cp=Cam.CFrame.Position local cl=Cam.CFrame.LookVector local d=p-cp
    local m=d.Magnitude if m<0.001 then return 0 end
    return math.deg(math.acos(math.clamp(cl:Dot(d/m),-1,1)))
end
local function collect()
    local l={}
    local cursor=UIS:GetMouseLocation()
    local cf=CHARS
    if not cf then return l end
    for _,ch in ipairs(cf:GetChildren()) do
        if ch:IsA("Model") and ch.Name~=LP.Name and isAlive(ch) then
            local pl=P:FindFirstChild(ch.Name)
            if isEnemy(pl,ch) then
                local head=ch:FindFirstChild("Head")
                if head and head:IsA("BasePart") then
                    local histPos=getHistoricalPosition(pl,head.Name) or head.Position
                    local d=(histPos-Cam.CFrame.Position).Magnitude
                    if d<=CFG.MaxDist then
                        local a=getAng(histPos)
                        if CFG.FOV>=180 or a<=CFG.FOV then
                            local part=pickPart(ch,cursor)
                            if part then
                                local ok=true
                                if CFG.VisibleOnly then
                                    local curPart=ch:FindFirstChild(part.Name)
                                    if curPart then ok=canSeePart(curPart) end
                                end
                                if ok then table.insert(l,{char=ch,player=pl,head=head,part=part,angle=a,dist=d,histPos=histPos}) elseif CFG.Debug then log("skip:",ch.Name) end
                            end
                        end
                    end
                end
            end
        end
    end
    table.sort(l,function(a,b) if math.abs(a.angle-b.angle)>3 then return a.angle<b.angle end return a.dist<b.dist end)
    return l
end
local function updT()
    if not CFG.Enabled then CurCh=nil CurPart=nil CurPos=nil return end
    local list=collect()
    if #list==0 then CurCh=nil CurPart=nil CurPos=nil return end
    local t=list[1]
    CurCh=t.char CurPart=t.part
    local cursor=UIS:GetMouseLocation()
    CurPos=scaleHitPart(t.part,cursor,0) or t.histPos or t.part.Position
end
local hookedModule=nil
local hookedOrig=nil
local weaponCache=nil
local weaponCacheTime=0
local lastReinstall=0
local shotCount=0


local function getBulletModule()
    local bm=RS.Components and RS.Components.Weapon and RS.Components.Weapon:FindFirstChild("Classes") and RS.Components.Weapon.Classes:FindFirstChild("Bullet")
    if not bm then return nil end
    local ok,B=pcall(require,bm)
    if not ok or type(B)~="table" or type(B._performRaycast)~="function" then return nil end
    return B
end


local function installSilent(force)
    local B=getBulletModule()
    if not B then return false end
    if not force and hookedModule==B and hookedOrig and B._performRaycast~=hookedOrig then return true end
    local orig=B._performRaycast
    hookedModule=B
    hookedOrig=orig
    lastReinstall=os.clock()
    B._performRaycast=function(self,spread)
        if CFG.Enabled and CurPart and CurPart.Parent and CurCh and CurCh.Parent and isAlive(CurCh) then
            local ok2,res=pcall(function()
                local ig=GetRI and GetRI() or {LP.Character,Cam}
                local vp=Cam.ViewportSize
                local ray=Cam:ViewportPointToRay(vp.X*0.5,vp.Y*0.5)
                local O=ray.Origin local Pt=CurPos or CurPart.Position
                local D=(Pt-O).Unit local tot=(Pt-O).Magnitude
                local rng=math.max((self.Properties and self.Properties.Range) or 500,tot+50)
                local pen=(self.Properties and self.Properties.Penetration) or 0
                local hd={Distance=tot,Origin=O,Direction=D,Hits={}}
                if CFG.UseRealRaycast and RCast and RCastThr then
                    local hi=RCast(O,D*rng,nil,ig)
                    if hi and hi.instance then
                        local hp=hi.position
                        hd.Distance=(hp-O).Magnitude
                        local ph=RCastThr(hp+D*-0.001,D*(pen+0.001),pen,ig)
                        if ph then for i=1,#ph do local p=ph[i] if p.instance and p.material then table.insert(hd.Hits,{Position=p.position,Instance=p.instance,Material=(p.material and p.material.Name) or tostring(p.material),Normal=p.normal or Vector3.new(0,0,0),Exit=(i%2==0)}) end end end
                    end
                else hd.Hits={{Position=Pt,Instance=CurPart,Material=CurPart.Material.Name,Normal=-D,Exit=false}} end
                return hd
            end)
            if ok2 and res and res.Hits and #res.Hits>0 then shotCount=shotCount+1 return res end
        end
        if orig then return orig(self,spread) end
    end
    log("hook #"..shotCount)
    return true
end


local function getWeapon(force)
    local now=os.clock()
    if weaponCache and not force and now-weaponCacheTime<2 then
        local ok,eq=pcall(weaponCache.peekCurrentEquippedForMovement)
        if ok and eq and eq.IsEquipped~=nil then return eq end
        weaponCache=nil
    end
    if type(getgc)=="function" then
        for _,o in ipairs(getgc(true)) do
            if type(o)=="table" and type(rawget(o,"peekCurrentEquippedForMovement"))=="function" then
                weaponCache=o weaponCacheTime=now
                local ok,eq=pcall(o.peekCurrentEquippedForMovement)
                if ok and eq then return eq end
            end
        end
    end
    return nil
end



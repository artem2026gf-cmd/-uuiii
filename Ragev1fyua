-- ===== main loop =====
local bs, bt = 0, setmetatable({}, {__mode = 'k'})
R.rageStatus = nil
R.rageCands = 0
R.bf, R.bg, R.bh = nil, nil, nil

RunService.Heartbeat:Connect(function()
    R.bf, R.bg, R.bh = nil, nil, nil

    if R.m() then return end

    local loopMode = aC.loopKill and aC.loopTarget ~= nil
    local killAllMode = aC.killAll

    if not aC.rage and not loopMode and not killAllMode then
        R.rageStatus = nil
        return
    end

    local weapon = R.p()
    if not weapon or not weapon.Bullet or not weapon.Properties then
        R.rageStatus = 'NO GUN'
        return
    end

    -- killAll
    if killAllMode and not weapon.IsReloading and R.lU() and R.qU(weapon) then
        local now = os.clock()
        for _, ent in ipairs(R.entities()) do
            if R.ET(ent) then
                local char = R.F(ent, 'Head')
                if char and not R.t(char) and now - (bt[ent] or 0) >= aC.killAllDelay then
                    if (weapon.Rounds or 0) <= 0 then R.yU(weapon) end
                    if (weapon.Rounds or 0) <= 0 then break end
                    if R.xU(weapon, char.Head, true) then
                        bt[ent] = now
                    end
                end
            end
        end
    end

    -- loop kill
    local loopPart = nil
    if loopMode then
        local ent = R.byName(aC.loopTarget)
        local char = ent and R.F(ent, 'Head')
        if char and not R.t(char) then
            loopPart = char.Head
        end
    end

    local targets = (not loopPart and aC.rage) and R.N(weapon) or {}

    -- indicator (если включён)
    if R.updateRageIndicator then
        pcall(R.updateRageIndicator, not loopPart and targets[1] or nil)
    end

    R.bg = loopPart or (targets[1] and targets[1].part) or nil
    R.bh = not loopPart and (targets[1] and targets[1].pos) or nil
    R.bf = R.bh or (R.bg and R.bg.Position) or nil

    if not R.bg then
        R.rageStatus = (R.rageCands or 0) > 0 and 'NO LINE' or 'NO TARGET'
        return
    end

    if not (loopPart or aC.rageAutoFire) then
        R.rageStatus = 'AUTO OFF'
        return
    end

    if (weapon.Rounds or 0) <= 0 or weapon.IsReloading then
        R.rageStatus = weapon.IsReloading and 'RELOAD' or 'NO AMMO'
        return
    end

    if not R.qU(weapon) then
        R.rageStatus = 'EQUIP'
        return
    end

    if aC.rageRemote or loopPart then
        local now = os.clock()
        local fireRate = R.tT(weapon)
        if aC.rapidFire then
            fireRate = fireRate / math.max(aC.rapidMult or 1, 1)
        end

        if now - bs < fireRate then
            R.rageStatus = ('WAIT %.1f'):format(fireRate - (now - bs))
            return
        end

        R.rageStatus = 'FIRE'
        bs = now

        local fireList = {}
        if loopPart then
            fireList[1] = {part = loopPart}
        elseif aC.rageMulti then
            fireList = targets
        else
            fireList[1] = targets[1]
        end

        local shots = {}
        for _, t in ipairs(fireList) do
            local count = 1
            if aC.tapKill and t.hp and t.dmg and t.dmg > 0 then
                count = math.clamp(math.ceil(t.hp / t.dmg), 1, aC.maxTaps)
            end
            if aC.doubleTap and count < 2 then count = 2 end
            if count > 1 then t.key = nil end

            for i = 1, count do
                shots[#shots + 1] = t
            end
        end

        local maxShots = fireRate == 0 and (weapon.Rounds or 1) or #shots
        local shotIdx = 0

        while shotIdx < maxShots do
            local t = shots[shotIdx % #shots + 1]

            if (weapon.Rounds or 0) <= aC.reloadAt and aC.autoReload and aC.remoteReload then
                R.yU(weapon)
            end
            if (weapon.Rounds or 0) <= 0 then break end
            if t.player and t.key then
                R.aZ.expect(t.player, t.key, t.raw)
            end

            R.xU(weapon, t.part, loopPart ~= nil or aC.wallBang, t.pos)
            shotIdx = shotIdx + 1
        end

        if aC.doubleTap and shotIdx >= 2 and fireRate > 0 then
            bs = now + fireRate
        end
    elseif not aC.rapidFire and not weapon.IsShooting and not weapon.IsFireHeld then
        R.vU(false, weapon)
    end
end)


-- ===== entities =====
R.aJ = nil
pcall(function() R.aJ = require(L.Components.Common.Participants) end)

local aL_cache = setmetatable({}, {__mode = 'k'})
local function R_wrap(bot)
    local cached = aL_cache[bot]
    if cached then return cached end
    cached = setmetatable({IsBot = true, UserId = 0}, {
        __index = function(_, k)
            if k == 'Character' then
                local ok, v = pcall(R.aJ.Character, bot)
                return ok and v or nil
            elseif k == 'Name' or k == 'DisplayName' then
                local ok, v = pcall(R.aJ.Name, bot)
                return (ok and type(v) == 'string') and v or bot.Name
            elseif k == 'Parent' then
                return bot.Parent
            end
            return nil
        end,
    })
    function cached.GetAttribute(self, k)
        local v = bot:GetAttribute(k)
        if v == nil then
            local ok, char = pcall(R.aJ.Character, bot)
            if ok and char then v = char:GetAttribute(k) end
        end
        return v
    end
    aL_cache[bot] = cached
    return cached
end

R.aM, R.aN = -1, nil

function R.entities()
    local now = os.clock()
    if R.aN and now - R.aM < 0.2 then return R.aN end
    R.aM = now
    local result = {}
    if R.aJ then
        local ok, all = pcall(R.aJ.GetAll)
        if ok and type(all) == 'table' then
            for _, ent in pairs(all) do
                if typeof(ent) == 'Instance' then
                    result[#result + 1] = ent:IsA('Player') and ent or R_wrap(ent)
                end
            end
        end
    end
    if #result == 0 and not R.aJ then
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP then result[#result + 1] = pl end
        end
    end
    if workspace:FindFirstChild('HordeShells') then
        local shells = workspace.HordeShells
        for _, m in ipairs(shells:GetChildren()) do
            if m:IsA('Model') and m:GetAttribute('HordeId') ~= nil
                and not m:GetAttribute('Ragdolled') and m:FindFirstChild('Head') then
                result[#result + 1] = {
                    IsZombie = true, IsBot = true, UserId = 0,
                    Name = 'zombie', DisplayName = 'zombie',
                    Character = m, Parent = m.Parent,
                    GetAttribute = function(_, k) return m:GetAttribute(k) end,
                }
            end
        end
    end
    R.aN = result
    return result
end

function R.ownerOf(char)
    if not char then return nil end
    for _, pl in ipairs(R.entities()) do
        if pl.Character == char then return pl end
    end
    return nil
end

function R.byName(name)
    for _, pl in ipairs(R.entities()) do
        if pl.Name == name then return pl end
    end
    return nil
end

-- ===== team =====
function R.h(p)
    if p == LP then return false end
    if type(p) == 'table' and p.IsZombie then return true end
    if workspace:FindFirstChild('HordeShells') then return false end
    if not R.aC.teamCheck then return true end
    if workspace:GetAttribute('Gamemode') == 'Deathmatch' then return true end
    local team = p:GetAttribute('Team')
    return (team == 'Terrorists' or team == 'Counter-Terrorists') and team ~= LP:GetAttribute('Team')
end

function R.F(p, part)
    local char = p.Character
    if not char then return nil end
    if char:GetAttribute('Dead') or char:GetAttribute('Ragdolled') then return nil end
    local hp = char:GetAttribute('Health')
    if type(hp) == 'number' and hp <= 0 then return nil end
    if not char:IsDescendantOf(workspace) then return nil end
    if not char:FindFirstChild(part or 'Head') then return nil end
    return char
end

function R.t(p)
    if p == nil then return false end
    if p:GetAttribute('Invincible') == true then return true end
    local owner = R.ownerOf(p)
    return owner ~= nil and owner:GetAttribute('Invincible') == true
end

-- ===== friends =====
R.aI_friends, R.aJ_friends = {}, setmetatable({}, {__mode = 'k'})

local function dT(pl)
    if pl == LP or R.aJ_friends[pl] ~= nil then return end
    R.aJ_friends[pl] = false
    task.spawn(function()
        local ok, res = pcall(LP.IsFriendsWith, LP, pl.UserId)
        R.aJ_friends[pl] = ok and res == true
    end)
end

for _, pl in ipairs(Players:GetPlayers()) do dT(pl) end
Players.PlayerAdded:Connect(dT)

function R.ET(p)
    if not R.h(p) or R.aI_friends[p.Name] then return false end
    if R.aC.ignoreFriends and R.aJ_friends[p] then return false end
    return true
end

-- ===== MT =====
function R.MT(part)
    for _, ent in ipairs(R.entities()) do
        local char = ent.Character
        if char and part:IsDescendantOf(char) then return ent end
    end
    return nil
end

function R.bT(worldPos, screenPos)
    local sp, onScreen = Cam:WorldToViewportPoint(worldPos)
    if not onScreen then return nil end
    return (Vector2.new(sp.X, sp.Y) - screenPos).Magnitude
end


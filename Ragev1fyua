-- ===== xU: SHOOT =====
function R.xU(weapon, targetPart, wallbang, backtrackPos)
    local props = weapon.Properties
    if not (props and weapon.Identifier and targetPart) then return false end

    local serverMode = R.a7.server
    if serverMode then backtrackPos = nil end

    local results = {}
    local bulletOrigin = not backtrackPos and R.EU(targetPart) or R.LT()
    local range = props.Range or 500
    local penValue = R.uT(props)
    local targetPos = backtrackPos or targetPart.Position
    local dir = (targetPos - bulletOrigin).Unit
    local bullets = {}

    for i = 1, math.max(props.BulletsPerShot or 1, 1) do
        local hits
        if backtrackPos then
            hits = R.jT(bulletOrigin, backtrackPos, targetPart, range, penValue, wallbang)
            if not hits then return false end
        else
            hits = R.DT(bulletOrigin, dir, range, penValue, targetPart, wallbang)
        end

        if serverMode then
            local last = hits[#hits]
            if not (last and last.Instance and last.Instance:IsDescendantOf(targetPart.Parent)) then
                return false
            end
            bullets[#bullets + 1] = {Direction = dir, Origin = bulletOrigin}
        else
            bullets[#bullets + 1] = {
                Direction = dir, Origin = bulletOrigin,
                Hits = R.kT(bulletOrigin, hits),
            }
        end
        results[#results + 1] = hits
    end

    weapon.ShotSeq = (weapon.ShotSeq or 0) + 1

    local payload = {
        IsSniperScoped = weapon.IsSniperScoped,
        ShootingHand = weapon.ShootingHand,
        Identifier = weapon.Identifier,
        Seq = weapon.ShotSeq,
        Bullets = bullets,
        ViewTick = serverMode and R.a7.viewTick() or nil,
        __pastahubblox = results,
    }

    local ok = pcall(a2.Inventory.ShootWeapon.Send, payload)
    if ok then
        weapon.Rounds = math.max((weapon.Rounds or 1) - 1, 0)
        weapon.RechargeStartTime = workspace:GetServerTimeNow()
    end
    return ok
end

-- ===== lU: killAll round check =====
local gameState
pcall(function() gameState = require(L.Database.Components.GameState) end)

function R.lU()
    if not aC.killAllWaitRound then return true end
    if not gameState then return true end
    local ok, state = pcall(gameState.GetStateAtTime,
        workspace:GetServerTimeNow() + (aC.killAllLeadMs or 0) / 1000)
    return ok and state == 'Round In Progress'
end

-- ===== yU: reload =====
function R.yU(weapon)
    local props = weapon.Properties
    if not (props and props.Rounds and weapon.Identifier) then return false end

    local isDM = workspace:GetAttribute('Gamemode') == 'Deathmatch'
    local capacity = weapon.Capacity or 0
    local missing = props.Rounds - (weapon.Rounds or 0)
    local toAdd = isDM and missing or math.min(missing, capacity)

    if toAdd <= 0 then return false end

    local ok = pcall(a2.Inventory.ReloadWeapon.Send, {
        Identifier = weapon.Identifier,
        Capacity = capacity,
        Rounds = weapon.Rounds,
    })
    if ok then
        weapon.Rounds = (weapon.Rounds or 0) + toAdd
        if not isDM then weapon.Capacity = capacity - toAdd end
    end
    return ok
end

-- ===== qU: equip check =====
local be_cache = setmetatable({}, {__mode = 'k'})

function R.qU(weapon)
    local tick = weapon and weapon.WeaponEquippedTick
    if type(tick) ~= 'number' then return true end
    local delay = be_cache[weapon]
    if not delay then
        delay = 0.5
        pcall(function()
            local anim = weapon.Viewmodel.Animation:getAnimation('Equip')
            if anim and type(anim.Length) == 'number' and anim.Length > 0 then
                delay = anim.Length
                be_cache[weapon] = delay
            end
        end)
    end
    return tick() - tick > delay * 0.925 + 0.03
end

-- ===== vU: fire click =====
function R.FT(weapon)
    local props = weapon and weapon.Properties
    if not (aC.revolverAlt and props and props.ShootingOptions == 'Revolver') then return nil end
    local fire = props.FireModes
    return type(fire) == 'table' and (type(fire.Secondary) == 'table' and fire.Secondary) or nil
end

function R.vU(hold, weapon)
    if hold then
        if mouse1release then mouse1release() end
        if mouse1press then mouse1press() end
    elseif R.FT(weapon) and mouse2click then
        mouse2click()
    elseif mouse1click then
        mouse1click()
    end
end

function R.tT(weapon)
    local alt = R.FT(weapon)
    if alt and type(alt.FireRate) == 'number' then return alt.FireRate end
    return weapon.Properties and weapon.Properties.FireRate or 0.1
end

-- ===== rU: knife =====
function R.rU(weapon, player, part)
    local props = weapon.Properties
    local range = props and props.Range or 3
    local origin = R.LT()
    local delta = part.Position - origin
    local dir = delta.Magnitude > 0 and delta.Unit or Cam.CFrame.LookVector

    local ok = pcall(a2.Melee.MeleeAttack.Send, {
        Direction = dir * range,
        Material = part.Material.Name,
        Distance = math.min(delta.Magnitude, range),
        Instance = part,
        Position = part.Position,
        Normal = -dir,
        MeleeAttack = 'BackStab',
        Identifier = weapon.Identifier,
    })
    return ok
end


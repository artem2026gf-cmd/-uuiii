-- Часть 3/4: трекеры (velocity/history), q() target scan, N() throttler

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local LP = Players.LocalPlayer
local L = game:GetService('ReplicatedStorage')
local Cam = workspace.CurrentCamera

local G = getgenv and getgenv() or _G
local R = G.ZbRage
if not R then error('Запусти часть 1') end

local aC = R.aC

-- ===== трекеры =====
R.ba_vel, R.bb_hist = setmetatable({}, {__mode = 'k'}), setmetatable({}, {__mode = 'k'})
R.HISTORY_SEC = 0.6
R.aK = setmetatable({}, {__mode = 'k'})  -- miss counter

RunService.Heartbeat:Connect(function(dt)
    if dt <= 0 then return end
    local parts = {
        'Head','UpperTorso','LowerTorso','HumanoidRootPart',
        'LeftUpperArm','LeftLowerArm','LeftHand',
        'RightUpperArm','RightLowerArm','RightHand',
        'LeftUpperLeg','LeftLowerLeg','LeftFoot',
        'RightUpperLeg','RightLowerLeg','RightFoot',
    }
    local prevPos = setmetatable({}, {__mode = 'k'})
    for _, ent in ipairs(R.entities()) do
        local char = ent ~= LP and ent.Character
        local hrp = char and char:FindFirstChild('HumanoidRootPart')
        if hrp then
            local pos = hrp.Position
            local prev = prevPos[ent]
            if prev then
                local v = (pos - prev) / dt
                if v.Magnitude > 80 then v = Vector3.zero end
                R.ba_vel[ent] = (R.ba_vel[ent] or v):Lerp(v, 0.35)
            end
            prevPos[ent] = pos
            if aC.backtrack then
                local hist = R.bb_hist[ent]
                if not hist then hist = {}; R.bb_hist[ent] = hist end
                local sample = {t = os.clock(), pos = {}}
                for _, n in ipairs(parts) do
                    local pt = char:FindFirstChild(n)
                    if pt then sample.pos[n] = pt.Position end
                end
                hist[#hist + 1] = sample
                while hist[1] and sample.t - hist[1].t > R.HISTORY_SEC do
                    table.remove(hist, 1)
                end
            elseif R.bb_hist[ent] then
                R.bb_hist[ent] = nil
            end
        else
            prevPos[ent], R.ba_vel[ent] = nil, nil
        end
    end
end)

function R.zU(part)
    local ms = aC.predictMs or 0
    if ms <= 0 or not part.Parent then return part.Position end
    local owner = R.ownerOf(part.Parent)
    local vel = owner and R.ba_vel[owner]
    if not vel then return part.Position end
    return part.Position + Vector3.new(vel.X, vel.Y * 0.5, vel.Z) * (ms / 1000)
end

-- ===== hitbox list =====
R.HITBOX_LIST = {
    Head = {'Head'},
    Body = {'UpperTorso','LowerTorso','HumanoidRootPart'},
    Multipoint = {'Head','UpperTorso','LowerTorso','HumanoidRootPart'},
    ['Full Body'] = {
        'Head','UpperTorso','LowerTorso',
        'LeftUpperArm','LeftLowerArm','LeftHand',
        'RightUpperArm','RightLowerArm','RightHand',
        'LeftUpperLeg','LeftLowerLeg','LeftFoot',
        'RightUpperLeg','RightLowerLeg','RightFoot',
    },
}

function R.l()
    return aC.minDmgOverride and aC.minDmgOverrideValue or aC.minDmg
end

local lastTargetPlayer = nil
local targetRotation = 0
R.misAdaptCount = R.misAdaptCount or setmetatable({}, {__mode = 'k'})

function R.q(weapon)
    local startTime = os.clock()
    local origin = R.LT()
    local props = weapon.Properties
    local penValue = R.uT(props)
    local maxDist = props.Range or 500
    local hitboxList = R.HITBOX_LIST[aC.rageHitbox] or R.HITBOX_LIST.Head
    if aC.forceBody then hitboxList = R.HITBOX_LIST.Body end

    local minDmg = R.l()
    local candidates = {}
    local screenCenter = Cam.ViewportSize / 2

    for _, ent in ipairs(R.entities()) do
        if R.ET(ent) then
            local char = R.F(ent, 'HumanoidRootPart')
            if char and not R.t(char) then
                local dist = (char.HumanoidRootPart.Position - origin).Magnitude
                local score
                if aC.rageTargetMode == 'Crosshair' then
                    score = R.bT(char.HumanoidRootPart.Position, screenCenter) or math.huge
                elseif aC.rageTargetMode == 'Lowest HP' then
                    score = (tonumber(char:GetAttribute('Health')) or 100) + dist / 10000
                else
                    score = dist
                end
                if aC.rageSticky and ent == R.lastTargetPlayer then
                    score = -math.huge
                end
                candidates[#candidates + 1] = {
                    player = ent, char = char, dist = dist,
                    hp = tonumber(char:GetAttribute('Health')) or 100,
                    score = score,
                }
            end
        end
    end

    table.sort(candidates, function(a, b) return a.score < b.score end)

    local output, total = {}, #candidates
    local startIdx = targetRotation <= total and targetRotation or 1
    targetRotation = 1

    for idx = 0, total - 1 do
        local candIdx = ((startIdx - 1) + idx) % total + 1
        local cand = candidates[candIdx]

        if idx > 0 and os.clock() - startTime > 0.004 then
            targetRotation = candIdx
            break
        end

        local hpTarget, hitbox = cand.hp, hitboxList
        if aC.missAdapt and (R.aK[cand.player] or 0) >= aC.missesToBody then
            hitbox = R.HITBOX_LIST.Body
        end

        local best, bestBody = {dmg = 0}, {dmg = 0}

        for _, partName in ipairs(hitbox) do
            local part = cand.char:FindFirstChild(partName)
            if part then
                local tpPos = R.EU(part)
                local visible, walls = tpPos ~= nil, 0

                if not tpPos then
                    tpPos = origin
                    visible, walls = R.E(origin, part, cand.char, penValue, maxDist)
                    if visible and aC.wallLimit and walls > aC.maxWalls then
                        visible = false
                    end
                end

                if visible then
                    local track = tpPos ~= origin and 'TP' or nil
                    local rawDmg = R.calcDamage(props, partName,
                        (part.Position - tpPos).Magnitude,
                        (aC.wallLimit and not R.a7.server) and 0 or walls,
                        cand.player)
                    local dmg, key = R.R(weapon, partName, walls, rawDmg)

                    if dmg > best.dmg then
                        best = {
                            part = part, dmg = dmg, raw = rawDmg,
                            key = key, walls = walls, track = track,
                        }
                    end
                    if R.PART_TO_ZONE[partName] == 'Torso' and dmg > bestBody.dmg then
                        bestBody = {
                            part = part, dmg = dmg, raw = rawDmg,
                            key = key, walls = walls, track = track,
                        }
                    end
                    if bestBody.dmg >= hpTarget
                        or (best.dmg >= hpTarget and not aC.preferBodyLethal) then
                        break
                    end
                end
            end
        end

        if aC.preferBodyLethal and bestBody.part and bestBody.dmg >= hpTarget then
            best = bestBody
        end

        local minHp = hpTarget <= minDmg and 0 or minDmg

        if not R.a7.server
            and not (best.part and (best.dmg >= minHp or best.dmg >= hpTarget))
            and (aC.backtrack or aC.forwardTrack) then

            local function try(d, p, pos, track)
                local ok, walls = R.mT(origin, pos, maxDist, penValue)
                if not ok or (walls > 0 and (not aC.rageAutowall and (not aC.wallbang and not aC.wallLimit))) then
                    return
                end
                if aC.wallLimit and walls > aC.maxWalls then return end
                local rawDmg = R.calcDamage(props, d, (pos - origin).Magnitude,
                    aC.wallLimit and 0 or walls, cand.player)
                local dmg, key = R.R(weapon, d, walls, rawDmg)
                if dmg > best.dmg then
                    best = {
                        part = p, dmg = dmg, raw = rawDmg,
                        key = key, walls = walls, pos = pos, track = track,
                    }
                end
            end

            if aC.backtrack then
                local hist = R.bb_hist[cand.player]
                local now = os.clock()
                if hist then
                    for i = #hist - 1, 1, -2 do
                        local sample = hist[i]
                        local age = now - sample.t
                        if age > aC.backtrackMs / 1000 then break end
                        if os.clock() - startTime > 0.004 then break end

                        for _, partName in ipairs(hitbox) do
                            local part = cand.char:FindFirstChild(partName)
                            local pos = sample.pos[partName]
                            if part and pos then
                                try(partName, part, pos, ('BT %dms'):format(age * 1000))
                            end
                        end

                        if best.pos and (best.dmg >= minHp or best.dmg >= hpTarget) then break end
                    end
                end
            end

            if aC.forwardTrack and not (best.pos and (best.dmg >= minHp or best.dmg >= hpTarget)) then
                local vel = R.ba_vel[cand.player]
                if vel and vel.Magnitude > 1 then
                    for _, mult in ipairs({0.5, 1}) do
                        if os.clock() - startTime > 0.004 then break end
                        local lead = (aC.forwardMs * mult) / 1000
                        for _, partName in ipairs(hitbox) do
                            local part = cand.char:FindFirstChild(partName)
                            if part then
                                try(partName, part, part.Position + vel * lead,
                                    ('FT %dms'):format(lead * 1000))
                            end
                        end
                        if best.pos and (best.dmg >= minHp or best.dmg >= hpTarget) then break end
                    end
                end
            end
        end

        if best.part and (best.dmg >= minHp or best.dmg >= hpTarget) then
            best.player, best.char, best.hp = cand.player, cand.char, hpTarget
            output[#output + 1] = best
            if not aC.rageMulti then break end
        end
    end

    R.lastTargetPlayer = output[1] and output[1].player or nil
    return output
end

-- ===== N throttler =====
local bn, bo = {}, 0

function R.N(weapon)
    local now = os.clock()
    if now - bo >= 1 / math.max(aC.rageScanHz, 1) then
        bo = now
        bn = R.q(weapon)
    else
        for i = #bn, 1, -1 do
            local t = bn[i]
            if not t.part.Parent or t.char:GetAttribute('Dead') or R.t(t.char) then
                table.remove(bn, i)
            end
        end
    end
    return bn
end


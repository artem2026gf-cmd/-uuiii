R.a5 = RaycastParams.new()
R.a5.FilterType = Enum.RaycastFilterType.Exclude
R.a5.CollisionGroup = 'Bullet'

R.a6 = RaycastParams.new()
R.a6.FilterType = Enum.RaycastFilterType.Include
R.a6.CollisionGroup = 'Bullet'

R.a0 = nil
R.a1 = {at = 0}
pcall(function() R.a0 = require(L.Components.Common.GetRayIgnore) end)

function R.GT()
    local now = os.clock()
    local char = LP.Character
    if R.a1.list and R.a1.char == char and now - R.a1.at < 0.1 then return R.a1.list end
    R.a1.at, R.a1.char = now, char
    local list = {}
    R.a1.list = list
    if R.a0 then
        local ok, res = pcall(R.a0)
        if ok and type(res) == 'table' then
            for _, v in ipairs(res) do list[#list + 1] = v end
        end
    end
    list[#list + 1] = char
    list[#list + 1] = Cam
    return list
end

-- ===== ST / YT =====
function R.ST(hit, exit)
    return {
        Instance = hit.Instance,
        Position = hit.Position,
        Normal = hit.Normal,
        Material = hit.Material.Name,
        Exit = exit == true,
    }
end

function R.YT(inst, dir)
    return {
        Instance = inst, Position = inst.Position,
        Normal = -dir, Material = inst.Material.Name, Exit = false,
    }
end


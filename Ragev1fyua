    IndoorWall = 0,
}

function R.BT(v)
    if v ~= 0 then return v end
    if workspace:GetAttribute('Map') == 'Reactor' then return -1 end
    return v
end

function R.sT(part)
    local parent = part.Parent
    if parent and parent:HasTag('BreakableDoor') then return Enum.Material.Metal end
    return part.Material
end

function R.gT(part)
    return part:FindFirstAncestorWhichIsA('Accessory') ~= nil
        or part:HasTag('CharacterAccessory')
        or part.Name == 'CollisionCapsule'
        or part.Name == 'HumanoidRootPart'
end


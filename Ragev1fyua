-- Часть 2/4: UT (raycast pen), DT, mT, jT, kT, урон, R calibration

local Players = game:GetService('Players')
local HS = game:GetService('HttpService')
local LP = Players.LocalPlayer
local L = game:GetService('ReplicatedStorage')
local Cam = workspace.CurrentCamera

local G = getgenv and getgenv() or _G
local R = G.ZbRage
if not R then error('Запусти часть 1') end

local aC = R.aC

-- ===== UT =====
function R.UT(origin, dir, maxDist, penValue, char, includeChars)
    R.a5.FilterDescendantsInstances = R.GT()
    if includeChars then
        local chars = workspace:FindFirstChild('Characters')
        if chars then R.a5:AddToFilter(chars) end
    end

    local hits, thickness, wallCount = {}, {}, 0
    local currentOrigin = origin

    for i = 1, 64 do
        local remain = maxDist - (currentOrigin - origin).Magnitude
        if remain <= 0 then break end

        local hit = workspace:Raycast(currentOrigin, dir * remain, R.a5)
        if not hit then break end

        R.a5:AddToFilter(hit.Instance)
        if not R.gT(hit.Instance) then
            hits[#hits + 1] = R.ST(hit)

            if char and hit.Instance:IsDescendantOf(char) then
                return hits, true, wallCount
            end

            if penValue == math.huge then
                wallCount = wallCount + 1
                currentOrigin = hit.Position + dir * 0.01
            else
                R.a6.FilterDescendantsInstances = {hit.Instance}
                local farPoint = hit.Position + dir * 1000
                local exitHit = workspace:Raycast(farPoint, hit.Position - farPoint, R.a6)
                if not exitHit then
                    return hits, false, wallCount, true
                end

                local thick = (hit.Position - exitHit.Position).Magnitude
                local variant = hit.Instance.MaterialVariant
                local limit

                if variant ~= '' and R.PEN_VAR[variant] ~= nil then
                    thickness[variant] = (thickness[variant] or 0) + thick
                    limit = R.BT(R.PEN_VAR[variant]) + penValue
                    if thickness[variant] > limit then return hits, false, wallCount, true end
                else
                    local mat = R.sT(hit.Instance)
                    thickness[mat] = (thickness[mat] or 0) + thick
                    limit = R.BT(R.PEN_MAT[mat] or 0) + penValue
                    if thickness[mat] > limit then return hits, false, wallCount, true end
                end

                hits[#hits + 1] = R.ST(exitHit, true)
                wallCount = wallCount + 1
                currentOrigin = exitHit.Position + dir * 0.001
            end
        end
    end
    return hits, false, wallCount
end

function R.DT(origin, dir, maxDist, penValue, char, wallbang)
    local charParent = char and char.Parent
    local hits, blocked = R.UT(origin, dir, maxDist, penValue, charParent)
    if wallbang and not R.a7.server and char and not blocked then
        hits[#hits + 1] = R.YT(char, dir)
    end
    return hits
end

function R.mT(from, to, maxDist, penValue)
    local delta = to - from
    local dist = delta.Magnitude
    if dist < 0.05 or dist > maxDist then return false, 0 end
    local hits, blocked, wallCount, hard = R.UT(from, delta.Unit, dist, penValue, nil, true)
    if hard then return false, wallCount end
    return true, wallCount, hits
end

function R.jT(from, to, part, maxDist, penValue, wallbang)
    local ok, wallCount, hits = R.mT(from, to, maxDist, penValue)
    if not ok then
        if not wallbang or R.a7.server then return nil end
        hits = {}
    end
    local dir = (to - from).Unit
    hits[#hits + 1] = {
        Instance = part, Position = to,
        Normal = -dir, Material = part.Material.Name, Exit = false,
    }
    return hits
end

function R.kT(origin, hits)
    local last = origin
    for _, h in ipairs(hits) do
        h.Distance = (h.Position - last).Magnitude
        last = h.Position
    end
    return hits
end

-- ===== урон =====
R.PART_TO_ZONE = {
    Head = 'Head', UpperTorso = 'Torso', LowerTorso = 'Torso',
    HumanoidRootPart = 'Torso', Torso = 'Torso',
    LeftUpperArm = 'Arms', LeftLowerArm = 'Arms', LeftHand = 'Arms',
    RightUpperArm = 'Arms', RightLowerArm = 'Arms', RightHand = 'Arms',
    LeftUpperLeg = 'Legs', LeftLowerLeg = 'Legs', LeftFoot = 'Legs',
    RightUpperLeg = 'Legs', RightLowerLeg = 'Legs', RightFoot = 'Legs',
}

function R.armorOf(player)
    local raw = player:GetAttribute('Armor')
    if type(raw) ~= 'string' then return 0, false end
    local ok, data = pcall(HS.JSONDecode, HS, raw)
    if not ok or type(data) ~= 'table' then return 0, false end
    return tonumber(data.Health) or 0,
        type(data.Type) == 'string' and data.Type:find('Helmet') ~= nil
end

function R.calcDamage(weapon, partName, dist, walls, player)
    local zone = R.PART_TO_ZONE[partName]
    local dmgPerPart = weapon.DamagePerPart
    if not zone or type(dmgPerPart) ~= 'table' or not dmgPerPart[zone] then return 0 end

    local dmg = dmgPerPart[zone]
    dmg = dmg * (weapon.RangeModifier or 1) ^ ((dist / 0.075) / 500)
    if walls > 0 then dmg = dmg * (weapon.WallbangMultiplier or 0.5) ^ walls end

    local armor, helmet = R.armorOf(player)
    if armor > 0 and (zone ~= 'Legs' and (zone ~= 'Head' or helmet)) then
        dmg = dmg * (weapon.ArmorPenetration or 1)
    end
    return dmg * (weapon.BulletsPerShot or 1)
end

function R.E(from, part, char, penValue, maxDist)
    local dir = (part.Position - from).Unit
    local hits, blocked, wallCount = R.UT(from, dir, maxDist, penValue, char)
    if blocked then
        if wallCount > 0 and not aC.rageAutowall
            and (R.a7.server or (not aC.wallbang and not aC.wallLimit)) then
            return false, 0
        end
        return true, wallCount
    end
    if aC.wallbang and not R.a7.server then
        local _, _, walls = R.UT(from, dir, maxDist, math.huge, char)
        return true, walls
    end
    return false, 0
end

function R.vehiclePos()
    local char = R.getCurrentCharacter()
    return char and char.CFrame or Cam.CFrame
end

-- ===== R calibration =====
R.aZ = {
    factor = {}, samples = {},
    key = function(name, zone, walls)
        return name .. '|' .. zone .. '|' .. (walls > 0 and 'wall' or 'open')
    end,
    get = function(key) return math.clamp(R.aZ.factor[key] or 1, 0.6, 1.4) end,
    expect = function(player, key, raw)
        R.aZ.meta[player] = {key = key, raw = raw, at = os.clock()}
    end,
    meta = {},
}

function R.R(weapon, partName, walls, rawDmg)
    local key = R.aZ.key(weapon.Name, R.PART_TO_ZONE[partName], walls)
    if R.a7.server then return rawDmg, key end
    return rawDmg * R.aZ.get(key), key
end

-- ===== bullet TP =====
R.a9 = {params = RaycastParams.new(), last = setmetatable({}, {__mode = 'k'})}
R.a9.params.FilterType = Enum.RaycastFilterType.Exclude
R.a9.params.CollisionGroup = 'Bullet'

function R.EU(part)
    if not aC.bulletTp or not part or not part.Parent then return nil end
    local origin = part.Position
    local toChar = R.vehiclePos().Position - origin
    local flat = Vector3.new(toChar.X, 0, toChar.Z)
    flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, 1)

    local right = flat:Cross(Vector3.new(0, 1, 0))
    local dist = aC.bulletTpDist
    local dirs = {flat, (flat + Vector3.new(0,1,0)).Unit, Vector3.new(0,1,0),
                  right, -right, (flat + right).Unit, (flat - right).Unit, -flat}

    R.a9.params.FilterDescendantsInstances = R.GT()
    local parent = part.Parent
    local lastDir = R.a9.last[part] or 1

    for i = 0, #dirs - 1 do
        local idx = ((lastDir - 1) + i) % #dirs + 1
        local dir = dirs[idx]
        local pos = origin + dir * dist
        local hit = workspace:Raycast(pos, dir * -(dist + 2), R.a9.params)
        if hit and hit.Instance:IsDescendantOf(parent) then
            R.a9.last[part] = idx
            return pos
        end
    end
    return nil
end

function R.LT()
    local aH = R.aH or {}
    local cf = aH.active and aH.eye or Cam.CFrame
    return cf.Position
end


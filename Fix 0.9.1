function A.Team(v)
if not v then return nil end
local ok,t=pcall(function()return v:GetAttribute("Team")end)
if ok and type(t)=="string" and t~="" then return t end
if v:IsA("Player") and v.Team then return v.Team.Name end
return nil
end
function A.Enemy(c)
if not c or c==LP.Character or c.Name==LP.Name then return false end
local pl=P:GetPlayerFromCharacter(c) or P:FindFirstChild(c.Name)
if pl==LP then return false end
local mine=A.Team(LP.Character) or A.Team(LP)
local theirs=A.Team(c) or A.Team(pl)
if mine and theirs then return mine~=theirs end
if pl then
if LP.Team and pl.Team then return LP.Team~=pl.Team end
return true
end
return c:GetAttribute("Bot")==true
end
function A.Health(c)
local h=c and c:GetAttribute("Health")
local m=c and c:GetAttribute("MaxHealth")
local hum=c and c:FindFirstChildOfClass("Humanoid")
if type(h)~="number" then h=hum and hum.Health or 100 end
if type(m)~="number" or m<=0 then m=hum and hum.MaxHealth or 100 end
return h,math.max(m,1)
end
function A.Valid(c)
if not c or not c.Parent then return false end
if c:GetAttribute("Dead")==true then return false end
local folder=workspace:FindFirstChild("Characters")
if folder and c.Parent~=folder then return false end
local hp=A.Health(c)
return hp>0 and A.Root(c)~=nil and A.Enemy(c)
end
function A.Collect()
local result={}
local folder=workspace:FindFirstChild("Characters")
if folder then
for _,c in ipairs(folder:GetChildren())do
if c:IsA("Model")then result[c]=true end
end
else
for _,pl in ipairs(P:GetPlayers())do
if pl~=LP and pl.Character then result[pl.Character]=true end
end
end
return result
end
function A.Bounds(c)
local root=A.Root(c)
if not root then return nil end
local head=c:FindFirstChild("Head")
local foot=c:FindFirstChild("LeftFoot") or c:FindFirstChild("RightFoot")
local top=head and head.Position+Vector3.new(0,head.Size.Y*.65+.25,0) or root.Position+Vector3.new(0,3,0)
local bottom=foot and foot.Position-Vector3.new(0,foot.Size.Y*.6+.2,0) or root.Position-Vector3.new(0,3,0)
return top,bottom
end
function A.Project(cam,top,bottom)
if not cam or not top or not bottom then return nil end
local t=cam:WorldToViewportPoint(top)
local b=cam:WorldToViewportPoint(bottom)
if t.Z<=0 or b.Z<=0 then return nil end
local h=math.abs(b.Y-t.Y)
local w=h*.575
local x=(t.X+b.X)*.5-w*.5
local y=math.min(t.Y,b.Y)
local size=cam.ViewportSize
if h<4 or x+w<0 or x>size.X or y+h<0 or y>size.Y then return nil end
return math.floor(x+.5),math.floor(y+.5),math.max(3,math.floor(w+.5)),math.max(4,math.floor(h+.5))
end

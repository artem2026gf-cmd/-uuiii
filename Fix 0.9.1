function A.Line(f,x1,y1,x2,y2,thickness)
local dx=x2-x1
local dy=y2-y1
local len=math.sqrt(dx*dx+dy*dy)
f.AnchorPoint=Vector2.new(.5,.5)
f.Position=UDim2.fromOffset((x1+x2)*.5,(y1+y2)*.5)
f.Size=UDim2.fromOffset(math.max(1,len),thickness or 1)
f.Rotation=math.deg(math.atan2(dy,dx))
f.Visible=true
end

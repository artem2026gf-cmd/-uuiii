local function drawBar(b,x,y,w,h,hp,max,dt)
local cfg=A.HC
if not cfg.enabled then
b.outer.Visible=false
b.text.text.Visible=false
return
end
local scale=math.clamp(h/110,.35,2)
local bw=math.max(2,math.floor(cfg.width*scale+.5))
local gap=math.max(3,math.floor(cfg.gap*scale+.5))
local bx=x-gap-bw
Pos(b.outer,bx,y,bw,h)
b.outer.Visible=true
b.outline.Enabled=cfg.outline
b.outline.Transparency=cfg.outlineTransparency
b.glow.Enabled=cfg.glow
b.glow.Transparency=cfg.glowTransparency
local ratio=math.clamp(hp/math.max(max,1),0,1)
b.smooth=b.smooth and b.smooth+(ratio-b.smooth)*math.clamp(dt*cfg.speed,0,1) or ratio
local fh=math.floor(h*b.smooth+.5)
Pos(b.mask,0,0,bw,fh)
b.mask.Visible=fh>0
Pos(b.fill,0,0,bw,h)
updateText(b.text,{enabled=cfg.number,glow=false,outline=false},math.floor(hp+.5),A.Color("Lavender"),bx-49,y+math.floor(h*.5)-4,43,18)
end
local bones={
{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},

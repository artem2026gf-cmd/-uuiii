return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("LowerTorso") or c.PrimaryPart or c:FindFirstChildWhichIsA("BasePart")

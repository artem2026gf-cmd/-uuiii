return obj
end
local function section(title)
pcall(function()T:Section({Title=title})end)
end
local function toggle(title,cfg,key)
return register(title,T:Toggle({
Title=title,
Value=cfg[key],
Callback=function(v)cfg[key]=v end
}))
end
local function slider(title,cfg,key,min,max,step)
return register(title,T:Slider({
Title=title,
Value={Min=min,Max=max,Default=cfg[key]},
Step=step,
Callback=function(v)
if type(v)=="number" then cfg[key]=v end
end
}))
end
local function dropdown(title,cfg,key,values)
return register(title,T:Dropdown({
Title=title,
Values=values,
Value=cfg[key],
Multi=false,
AllowNone=false,
Callback=function(v)
if type(v)=="table" then v=v[1]end
if type(v)=="string" then cfg[key]=v end
end
}))
end

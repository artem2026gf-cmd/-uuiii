local function newLines(n)
local arr={}
for i=1,n do
arr[i]={main=segment(gui),glow=segment(gui),outline=segment(gui)}
end
return arr
end
local function hideLines(arr)
for _,v in ipairs(arr)do
v.main.Visible=false
v.glow.Visible=false
v.outline.Visible=false
end
end
local function drawLines(arr,cfg,points,color,width)
hideLines(arr)
if not cfg.enabled then return end
for i,p in ipairs(points)do
local o=arr[i]
if o then
o.main.BackgroundColor3=color
Line(o.main,p[1],p[2],p[3],p[4],width)
o.glow.Visible=cfg.glow
if cfg.glow then
o.glow.BackgroundColor3=color
o.glow.BackgroundTransparency=cfg.glowTransparency
Line(o.glow,p[1],p[2],p[3],p[4],width+3)
end
o.outline.Visible=cfg.outline
if cfg.outline then
o.outline.BackgroundColor3=A.Dark
o.outline.BackgroundTransparency=cfg.outlineTransparency
Line(o.outline,p[1],p[2],p[3],p[4],width+2)
end
end
end
end
local function skeleton(c,cam)
local pairsList=c:FindFirstChild("UpperTorso") and bones or r6
local result={}
for _,pair in ipairs(pairsList)do
local a=c:FindFirstChild(pair[1])
local b=c:FindFirstChild(pair[2])
if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
local x=cam:WorldToViewportPoint(a.Position)
local y=cam:WorldToViewportPoint(b.Position)
if x.Z>0 and y.Z>0 then
result[#result+1]={x.X,x.Y,y.X,y.Y}
end
end
end
return result
end
local weaponCache={}
local function weaponName(c)
local pl=P:GetPlayerFromCharacter(c) or P:FindFirstChild(c.Name)
if not pl then return nil end
local raw=pl:GetAttribute("CurrentEquipped")
if type(raw)~="string" then return nil end
local old=weaponCache[pl]
if old and old.raw==raw then return old.name end
local ok,data=pcall(A.Http.JSONDecode,A.Http,raw)
local name=ok and type(data)=="table" and data.Name or nil
weaponCache[pl]={raw=raw,name=name}
return name
end

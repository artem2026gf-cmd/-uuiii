local function newBox()
local holder=frame(gui,Color3.new(1,1,1),10)
holder.BackgroundTransparency=1
local b={holder=holder,main={},glow={},outline={}}
for i=1,8 do
b.outline[i]=segment(holder)
b.glow[i]=segment(holder)
b.main[i]=segment(holder)
end
b.fill=frame(holder,A.Color("Ice Amethyst"),8)
return b
end
local function hideBox(b)
if b then b.holder.Visible=false end
end
local function drawBox(b,x,y,w,h,cfg,alpha)
if not b then return end
alpha=alpha or 0
local color=A.Color("Ice Amethyst")
local l=math.max(3,math.floor(math.min(w,h)*.23))
local seg
if cfg.mode=="full" then
seg={
{0,0,w,0},{w,0,w,h},{w,h,0,h},{0,h,0,0}
}
else
seg={
{0,0,l,0},{0,0,0,l},
{w-l,0,w,0},{w,0,w,l},
{0,h-l,0,h},{0,h,l,h},
{w,h-l,w,h},{w-l,h,w,h}
}
end
b.holder.Visible=true
Pos(b.holder,x,y,w,h)
b.fill.Visible=cfg.filled==true
if cfg.filled then
Pos(b.fill,0,0,w,h)
b.fill.BackgroundColor3=color
b.fill.BackgroundTransparency=math.clamp(cfg.filledTransparency+alpha,0,1)
end
for i=1,8 do
local s=seg[i]
local main=b.main[i]
local glow=b.glow[i]
local outline=b.outline[i]
if s then
main.BackgroundColor3=color
main.BackgroundTransparency=alpha
Line(main,s[1],s[2],s[3],s[4],1)
glow.Visible=cfg.glow==true
if cfg.glow then
glow.BackgroundColor3=color
glow.BackgroundTransparency=math.clamp(cfg.glowTransparency+alpha,0,1)
Line(glow,s[1],s[2],s[3],s[4],4)
end
outline.Visible=cfg.outline==true
if cfg.outline then
outline.BackgroundColor3=A.Dark
outline.BackgroundTransparency=math.clamp(cfg.outlineTransparency+alpha,0,1)
Line(outline,s[1],s[2],s[3],s[4],3)
end
else
main.Visible=false
glow.Visible=false
outline.Visible=false
end
end
end

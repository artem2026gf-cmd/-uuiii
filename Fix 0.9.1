local A=assert(getgenv().AuroraHubV55,"Сначала запусти часть 1")
assert(A.NewBox and A.DrawBox,"Сначала запусти часть 2")
local R=A.RunService
local P=A.Players
local LP=A.LocalPlayer
local Rep=game:GetService("ReplicatedStorage")
local H=A.Http
local markers={}
local received=0
local accepted=0
local connected=false
local soundConnection
local soundRender
local soundActive=true
local lastSound=0
local recent={}
local ignored={"Bomb","Plant","Defus","Killed","Music","Hostage","Round","Win"}
local function count()
local n=0
for _ in pairs(markers)do n=n+1 end
return n
end
local function decode(raw)
if type(raw)~="string" then return nil end
local ok,data=pcall(H.JSONDecode,H,raw)
return ok and type(data)=="table" and data or nil
end
local function culled(pl)
local folder=Rep:FindFirstChild("_PVS_CulledCharacters")
return folder and folder:FindFirstChild(pl.Name)
end
local function whoFired(cls)
if type(cls)~="string" then return nil end
local result=nil
local total=0
for _,pl in ipairs(P:GetPlayers())do
if pl~=LP then
local c=pl.Character or culled(pl)
local mine=A.Team(LP.Character) or A.Team(LP)
local theirs=A.Team(pl) or A.Team(c)
local ally=mine and theirs and mine==theirs
if not ally and not (c and c:GetAttribute("Dead")==true) then
local data=decode(pl:GetAttribute("CurrentEquipped"))
if data and data.Name==cls then
total=total+1
result=pl
end
end
end
end
return total==1 and result or nil
end
local function nearCharacter(pos)
local folder=workspace:FindFirstChild("Characters")
if not folder then return false end
for _,c in ipairs(folder:GetChildren())do
if c:IsA("Model")then
local r=A.Root(c)
if r and (r.Position-pos).Magnitude< A.SC.playerRange then
return true
end
end
end
return false
end
local function ownPosition()
local r=A.Root(LP.Character)
if r then return r.Position end
local cam=workspace.CurrentCamera
return cam and cam.CFrame.Position
end
local function hideMarker(m)
if m.box then m.box.holder.Visible=false end
end
local function removeMarker(i)
local m=markers[i]
if m then
if m.box then pcall(function()m.box.holder:Destroy()end)end
markers[i]=nil
end
end
local function addMarker(pos,cls)
local now=os.clock()
for _,m in pairs(markers)do
if (m.pos-pos).Magnitude<=A.SC.merge then
local delta=now-m.updated
if delta>=.05 and delta<=.5 then
local velocity=(pos-m.pos)/delta
if velocity.Magnitude<32 then m.velocity=velocity end
end
m.pos=pos
m.updated=now
m.created=now
return
end
end
if count()>=64 then
local oldest
local stamp=math.huge
for i,m in pairs(markers)do
if m.created<stamp then
stamp=m.created
oldest=i
end
end
if oldest then removeMarker(oldest)end
end
local id=now+math.random()
markers[id]={pos=pos,created=now,updated=now,velocity=Vector3.zero,cls=cls,box=nil}
accepted=accepted+1
end
local function onSound(sound)
received=received+1
if not soundActive or not A.SC.enabled then return end
if type(sound)~="table" then return end
local pos=sound.Position
if typeof(pos)~="Vector3" then return end
local cls=tostring(sound.Class or "")
local name=tostring(sound.Name or "")
for _,v in ipairs(ignored)do
if cls:lower():find(v:lower(),1,true) or name:lower():find(v:lower(),1,true)then return end
end
local now=os.clock()
if now-lastSound<1/120 then return end
lastSound=now
local origin=ownPosition()
if not origin then return end
local distance=(pos-origin).Magnitude
if distance<A.SC.selfRange or distance>A.SC.distance/.28 then return end
if nearCharacter(pos)then return end
local shooter=whoFired(cls)
if A.SC.teamCheck and shooter then
local mine=A.Team(LP.Character) or A.Team(LP)
local theirs=A.Team(shooter.Character) or A.Team(shooter)
if mine and theirs and mine==theirs then return end
end
addMarker(pos,cls)
end
local function connectSound()
local ok,err=pcall(function()
local database=Rep:WaitForChild("Database",15)
assert(database,"Database missing")
local security=database:WaitForChild("Security",15)
assert(security,"Security missing")
local module=security:WaitForChild("Remotes",15)
assert(module,"Remotes missing")
local remotes=require(module)
assert(remotes.Sound and remotes.Sound.ReplicateSound,"Sound remote missing")
soundConnection=remotes.Sound.ReplicateSound.Connect(function(sound)
local success,message=pcall(onSound,sound)
if not success then warn("[AURORA SOUND]",message)end
end)
connected=true
end)
if not ok then warn("[AURORA SOUND CONNECTION]",err)end
end
task.spawn(connectSound)
local soundCfg={mode="corners",filled=false,glow=true,glowTransparency=.85,outline=true,outlineTransparency=.65}
soundRender=R.RenderStepped:Connect(function()
if not soundActive or not A.Active then return end
local now=os.clock()
local cam=workspace.CurrentCamera
for i,m in pairs(markers)do
local age=now-m.created
if age>A.SC.life then
removeMarker(i)
elseif not A.SC.enabled or not cam then
hideMarker(m)
else
local ok,err=pcall(function()
local prediction=math.clamp(now-m.updated,0,.4)
local pos=m.pos+m.velocity*prediction
local x,y,w,h=A.Project(cam,pos+Vector3.new(0,5.5,0),pos)
if x then
if not m.box then m.box=A.NewBox()end
A.DrawBox(m.box,x,y,w,h,soundCfg,math.clamp(age/A.SC.life*.8,0,.8))
else
hideMarker(m)
end
end)
if not ok then
hideMarker(m)
if not m.errorTime or now-m.errorTime>5 then
warn("[AURORA SOUND RENDER]",err)
m.errorTime=now
end
end
end
end
end)
A.SoundStats=function()
return {
Connected=connected,
Received=received,
Accepted=accepted,
Markers=count(),
Enabled=A.SC.enabled
}
end
A.StopSound=function()
soundActive=false
if soundRender then soundRender:Disconnect()end
if soundConnection then
pcall(function()soundConnection:Disconnect()end)
end
for i in pairs(markers)do removeMarker(i)end
end
local materials={
ForceField=Enum.Material.ForceField,
Glass=Enum.Material.Glass,
SmoothPlastic=Enum.Material.SmoothPlastic,
Neon=Enum.Material.Neon,
Metal=Enum.Material.Metal,
Ice=Enum.Material.Ice
}
local original={}
local chamsActive=true
local chamsConnection
local skip={
muzzlepart=true,
hitbox=true,
fakemag=true,
viewmodellight=true,
humanoidrootpart=true,
camerapart=true
}
local handWords={
leftarm=true,rightarm=true,
leftupperarm=true,rightupperarm=true,
leftlowerarm=true,rightlowerarm=true,
lefthand=true,righthand=true,
leftglove=true,rightglove=true,
leftsleeve=true,rightsleeve=true
}
local function normalize(s)
return tostring(s):lower():gsub("[%s_%-]","")
end
local function isHand(part)
local name=normalize(part.Name)
if handWords[name] then return true end
if name:find("glove",1,true) or name:find("sleeve",1,true)then return true end
local p=part.Parent
while p and p~=workspace.CurrentCamera do
local n=normalize(p.Name)
if n:find("glove",1,true) or n=="arms" or n=="hands" or n:find("sleeve",1,true)then
return true
end
p=p.Parent
end
return false
end
local function classify(part)
if skip[normalize(part.Name)]then return nil end
if part.Transparency>=.99 and not original[part]then return nil end
return isHand(part) and "hand" or "gun"
end
local function save(part,kind)
local old=original[part]
if old then return old end
old={
material=part.Material,
color=part.Color,
transparency=part.Transparency,
reflectance=part.Reflectance,
kind=kind,
hidden={}
}
if part:IsA("MeshPart")then
old.textureID=part.TextureID
end
original[part]=old
return old
end
local function hideTextures(part,old)
for _,v in ipairs(part:GetChildren())do
if v:IsA("SurfaceAppearance") or v:IsA("Decal") or v:IsA("Texture") then
local exists=false
for _,entry in ipairs(old.hidden)do
if entry.object==v then exists=true break end
end
if not exists then
old.hidden[#old.hidden+1]={object=v,parent=v.Parent}
v.Parent=nil
end
end
end
if part:IsA("MeshPart")then
pcall(function()part.TextureID=""end)
end
end
local function restore(part)
local old=original[part]
if not old then return end
if part and part.Parent then
pcall(function()
part.Material=old.material
part.Color=old.color
part.Transparency=old.transparency
part.Reflectance=old.reflectance
if old.textureID~=nil and part:IsA("MeshPart")then
part.TextureID=old.textureID
end
end)
end
for _,entry in ipairs(old.hidden)do
pcall(function()
if entry.object then entry.object.Parent=entry.parent end
end)
end
original[part]=nil
end
local function apply(part,cfg,kind)
local old=save(part,kind)
old.kind=kind
hideTextures(part,old)
pcall(function()
part.Material=materials[cfg.material] or Enum.Material.ForceField
part.Color=A.Color(cfg.color)
part.Transparency=cfg.transparency
part.Reflectance=0
end)
end
local function renderChams()
local camera=workspace.CurrentCamera
local seen={}
if camera and (A.HandC.enabled or A.GunC.enabled)then
for _,model in ipairs(camera:GetChildren())do
if model:IsA("Model")then
for _,part in ipairs(model:GetDescendants())do
if part:IsA("BasePart")then
local kind=classify(part)
local cfg=kind=="hand" and A.HandC or A.GunC
if kind and cfg.enabled then
seen[part]=true
apply(part,cfg,kind)
end
end
end
end
end
end
for part in pairs(original)do
if not seen[part]then restore(part)end
end
end
local elapsed=0
chamsConnection=R.RenderStepped:Connect(function(dt)
if not chamsActive or not A.Active then return end
elapsed=elapsed+dt
if elapsed<.05 then return end
elapsed=0
local ok,err=pcall(renderChams)
if not ok then warn("[AURORA CHAMS]",err)end
end)
A.StopChams=function()
chamsActive=false
if chamsConnection then chamsConnection:Disconnect()end
for part in pairs(original)do restore(part)end
end

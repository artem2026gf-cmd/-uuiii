v.glow:Destroy()
v.outline:Destroy()
end
end
o.name.text:Destroy()
o.distance.text:Destroy()
o.weapon.text:Destroy()
end
local function renderTarget(c,o,cam,dt)
if not A.Valid(c) then hideTarget(o)return end
local top,bottom=A.Bounds(c)
local x,y,w,h=A.Project(cam,top,bottom)
if not x then hideTarget(o)return end
if A.C.enabled then
drawBox(o.box,x,y,w,h,A.C)
else
hideBox(o.box)
end
local hp,max=A.Health(c)
drawBar(o.bar,x,y,w,h,hp,max,dt)
local sp=A.SK
if sp.enabled then
drawLines(o.skeleton,sp,skeleton(c,cam),A.Color(sp.color),sp.thickness)
else
hideLines(o.skeleton)
end
if A.TC.enabled then
local size=cam.ViewportSize
drawLines(o.tracer,A.TC,{{size.X*.5,size.Y,x+w*.5,y+h}},A.Color(A.TC.color),1)
else
hideLines(o.tracer)
end
local pl=P:GetPlayerFromCharacter(c) or P:FindFirstChild(c.Name)
local name=pl and (pl.DisplayName or pl.Name) or c.Name
updateText(o.name,A.NC,name,A.Color("Lavender"),x+w*.5-85,y-23,170,19)
local root=A.Root(c)
local distance=root and math.floor((cam.CFrame.Position-root.Position).Magnitude*.28+.5)
updateText(o.distance,A.DC,distance and tostring(distance).."m",A.Color("Lavender"),x+w*.5-65,y+h+5,130,18)
updateText(o.weapon,A.WC,weaponName(c),A.Color(A.WC.color),x+w*.5-85,y+h+(A.DC.enabled and 24 or 5),170,19)
end
local active=true
local accumulator=0
local connection
connection=R.RenderStepped:Connect(function(dt)
if not active or not A.Active then return end
accumulator=accumulator+dt
if accumulator<1/45 then return end
dt=accumulator
accumulator=0
local cam=workspace.CurrentCamera
if not cam then return end
local current=A.Collect()
for c,o in pairs(objects)do
if not current[c] or not A.Valid(c) then
destroyTarget(o)
objects[c]=nil
end
end
local any=A.C.enabled or A.HC.enabled or A.SK.enabled or A.TC.enabled or A.NC.enabled or A.DC.enabled or A.WC.enabled
if not any then
for _,o in pairs(objects)do hideTarget(o)end
return
end
for c in pairs(current)do
if A.Valid(c)then
local o=objects[c]
if not o then
o=newTarget()
objects[c]=o
end
local ok,err=pcall(renderTarget,c,o,cam,dt)
if not ok then
hideTarget(o)
if not o.lastError or os.clock()-o.lastError>5 then
warn("[AURORA ESP]",err)
o.lastError=os.clock()
end
end
end
end
end)

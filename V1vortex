-- Test one participant at a time. Casts use current weapon penetration; the
-- client cannot know server armor, invulnerability or validation decisions.
local visibilityAccumulator, visibilityIndex = 0, 0
local visibilityConnection = RunService.Heartbeat:Connect(function(dt)
    local needed = false
    for _, cfg in pairs(featureVisibility) do if cfg.check or cfg.only then needed = true break end end
    if not needed then return end
    visibilityAccumulator = visibilityAccumulator + dt
    if visibilityAccumulator < 0.15 then return end
    visibilityAccumulator = 0
    local current = {}
    for _, rec in pairs(records) do current[#current + 1] = rec end
    if #current == 0 then return end
    visibilityIndex = visibilityIndex % #current + 1
    local rec = current[visibilityIndex]
    local ok, reachable = pcall(function()
        local camera = workspace.CurrentCamera
        if not camera or not rec.character:IsDescendantOf(workspace) then return false end
        local controller = RS:FindFirstChild("Controllers")
        local inventoryModule = controller and controller:FindFirstChild("InventoryController")
        if not inventoryModule then return false end
        local inventory = require(inventoryModule)
        local weapon = inventory.peekCurrentEquippedForMovement()
        if not weapon or not weapon.IsEquipped or weapon.IsDestroyed or not weapon.Properties then return false end
        local props = weapon.Properties
        local range = tonumber(props.Range) or 500
        local penetration = tonumber(props.Penetration) or 0
        local center = camera.ViewportSize * 0.5
        local origin = camera:ViewportPointToRay(center.X, center.Y).Origin
        local ignore = ignoreList()
        for _, part in ipairs(rec.parts) do
            if part.Parent == rec.character then
                local delta = part.Position - origin
                local distance = delta.Magnitude
                if distance > 0.001 and distance <= range then
                    local hits = Raycast.castThroughDistance(origin, delta.Unit * math.min(range, distance + 0.1), penetration, ignore)
                    for _, hit in ipairs(hits) do
                        if hit.instance and hit.instance:IsDescendantOf(rec.character) then return true end
                    end
                end
            end
        end
        return false
    end)
    rec.canHit = ok and reachable == true
end)
ui:onunload(function() visibilityConnection:Disconnect() end)


local dotRenderName = "BlockStrikeHeadDotESP"
RunService:BindToRenderStep(dotRenderName, Enum.RenderPriority.Camera.Value + 2, function()
    local camera = workspace.CurrentCamera
    for _, rec in pairs(records) do
        local dot = rec.headDot
        local head = rec.character:FindFirstChild("Head")
        if headDotEnabled and featureVisible(rec, "headDot") and camera and rec.character:IsDescendantOf(workspace)
            and head and head:IsA("BasePart") then
            local point, onScreen = camera:WorldToViewportPoint(head.Position)
            dot.Visible = onScreen and point.Z > 0.2
            if dot.Visible then
                -- Scale with the head's projected screen width rather than a fixed
                -- number of pixels, so it shrinks when the opponent moves away.
                local halfWidth = head.Size.X * 0.5
                local right = camera.CFrame.RightVector * halfWidth
                local a = camera:WorldToViewportPoint(head.Position - right)
                local b = camera:WorldToViewportPoint(head.Position + right)
                -- Match the full projected width of the head rather than 45%.
                local diameter = math.clamp(math.abs(b.X - a.X), 1, camera.ViewportSize.Y * 2)
                dot.Position = UDim2.fromOffset(point.X, point.Y)
                dot.Size = UDim2.fromOffset(diameter, diameter)
                local lineWidth = math.clamp(diameter * 0.10, 0.35, 1)
                rec.dotLine.Thickness = lineWidth
                rec.dotOutline.Thickness = lineWidth * 3
            end
        else
            dot.Visible = false
        end
    end
end)

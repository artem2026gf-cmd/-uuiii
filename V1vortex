    if not state.enabled or not drawFov or not targetColorEnabled then
        if targetFound then targetFound = false; refreshVisualColors() end
        return
    end
    local now = os.clock()
    if now - lastTargetCheck < 0.2 then return end
    lastTargetCheck = now
    local camera = workspace.CurrentCamera
    local ok, found = pcall(function()
        if not camera then return false end
        local inventory = require(RS:WaitForChild("Controllers"):WaitForChild("InventoryController"))
        local weapon = inventory.peekCurrentEquippedForMovement()
        if not weapon or not weapon.IsEquipped or weapon.IsDestroyed or not weapon.Properties then
            return false
        end
        return buildShot(weapon.Properties, camera) ~= nil
    end)
    found = ok and found or false

local function healthGradientSequence()
    -- Smoothstep interpolation adds intermediate colors around both transitions.
    local keys = {}
    for i = 0, 8 do
        local t = i / 8
        local a, b, u
        if t <= 0.5 then a, b, u = healthColor1, healthColor2, t * 2
        else a, b, u = healthColor2, healthColor3, (t - 0.5) * 2 end
        local smooth = u * u * (3 - 2 * u)
        keys[#keys + 1] = ColorSequenceKeypoint.new(t, a:Lerp(b, smooth))
    end
    return ColorSequence.new(keys)
end

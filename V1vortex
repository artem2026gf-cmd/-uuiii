local function teamOf(participant)
    local team = participant:GetAttribute("Team")
    if type(team) == "string" and team ~= "" then return team end
    if participant:IsA("Player") and participant.Team then
        return participant.Team.Name
    end
    return nil
end

local function candidates(camera, origin, range, properties)
    local center = camera.ViewportSize * 0.5
    local myTeam = teamOf(player)
    local result = {}
    for _, participant in ipairs(Participants.GetAll()) do
        if participant ~= player and Participants.IsAlive(participant) then
            local targetTeam = teamOf(participant)
            local enemy = not TEAM_CHECK or (myTeam ~= nil and targetTeam ~= nil and myTeam ~= targetTeam)
            if enemy then
                local character = Participants.Character(participant)
                if character and character:IsDescendantOf(workspace)
                    and character:GetAttribute("Dead") ~= true then
                    for _, name in ipairs(TARGET_NAMES) do
                        if SELECTED[name] then
                            local part = character:FindFirstChild(name)
                            if part and part:IsA("BasePart") then
                                local offset = part.Position - origin
                                local distanceWorld = offset.Magnitude
                                if distanceWorld > 0.001 and distanceWorld <= range then
                                    local point, visible = camera:WorldToViewportPoint(part.Position)
                                    if visible and point.Z > 0 then
                                        local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
                                        if distance <= FOV_RADIUS then
                                            -- A coarse projected-size estimate; not a measured hit probability.
                                            local size = part.Size
                                            local score = (size.X * size.Y + size.Y * size.Z + size.X * size.Z) / (point.Z * point.Z)
                                            local perPart = type(properties.DamagePerPart) == "table" and properties.DamagePerPart or nil
                                            local damage = perPart and tonumber(perPart[DAMAGE_GROUP[name]]) or nil
                                            result[#result + 1] = {character = character, part = part, distance = distance, score = score, damage = damage}
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    table.sort(result, function(a, b)
        if TARGET_PRIORITY == "Damage" then
            local da, db = a.damage or -1, b.damage or -1
            if da ~= db then return da > db end
        end
        if math.abs(a.score - b.score) > 1e-9 then return a.score > b.score end
        return a.distance < b.distance
    end)
    return result
end

local function buildShot(properties, camera)
    local center = camera.ViewportSize * 0.5
    local origin = camera:ViewportPointToRay(center.X, center.Y).Origin
    local range = math.min(tonumber(properties.Range) or 500, MAX_DISTANCE)
    local penetration = properties.Penetration or 0
    local targets = candidates(camera, origin, range, properties)
    if #targets == 0 then return nil end
    local ignored = ignoreList()
    for _, target in ipairs(targets) do
        local offset = target.part.Position - origin
        if offset.Magnitude > 0.001 then
            local direction = offset.Unit
            local hits = Raycast.castThroughDistance(origin, direction * range, penetration, ignored)
            local reached = false
            for _, hit in ipairs(hits) do
                if hit.instance == target.part then
                    reached = true
                    break
                end
                -- Wall check on: only an unobstructed first hit is accepted.
                if WALL_CHECK then break end
            end
            if reached then
                local shot = { Origin = origin, Direction = direction, Distance = range, Hits = {} }
                if hits[1] then shot.Distance = (hits[1].position - origin).Magnitude end
                for i, hit in ipairs(hits) do
                    if hit.instance and hit.material then
                        shot.Hits[#shot.Hits + 1] = {
                            Position = hit.position, Instance = hit.instance,
                            Material = hit.material.Name,
                            Normal = hit.normal or Vector3.new(0, 0, 0),
                            Exit = i % 2 == 0
                        }
                    end
                end
                return shot, target.character
            end
        end
    end
    return nil
end



local arrowRenderName = "BlockStrikeOffscreenArrows"
RunService:BindToRenderStep(arrowRenderName, Enum.RenderPriority.Camera.Value + 2, function()
    local camera = workspace.CurrentCamera
    for _, rec in pairs(records) do
        local arrow = rec.arrow
        local root = rec.character:FindFirstChild("HumanoidRootPart") or rec.character:FindFirstChild("Head")
        if not arrowsEnabled or not featureVisible(rec, "arrows") or not camera or not rec.character:IsDescendantOf(workspace)
            or not root or not root:IsA("BasePart") then
            arrow.Visible = false
        else
            local projected, onScreen = camera:WorldToViewportPoint(root.Position)
            if onScreen and projected.Z > 0 then
                arrow.Visible = false
            else
                local viewport = camera.ViewportSize
                local center = viewport * 0.5
                local direction
                if projected.Z > 0 then
                    direction = Vector2.new(projected.X - center.X, projected.Y - center.Y)
                else
                    local relative = camera.CFrame:PointToObjectSpace(root.Position)
                    direction = Vector2.new(relative.X, -relative.Y)
                end
                if direction.Magnitude < 0.001 then direction = Vector2.new(0, 1) end
                direction = direction.Unit
                local margin = arrowSize * 0.5 + 14
                local halfW = math.max(1, center.X - margin)
                local halfH = math.max(1, center.Y - margin)
                local xScale = math.abs(direction.X) > 0.0001 and halfW / math.abs(direction.X) or math.huge
                local yScale = math.abs(direction.Y) > 0.0001 and halfH / math.abs(direction.Y) or math.huge
                local position = center + direction * math.min(xScale, yScale) * (arrowDistance / 100)
                arrow.Position = UDim2.fromOffset(position.X, position.Y)
                arrow.Rotation = math.deg(math.atan2(direction.Y, direction.X)) + 90
                arrow.Visible = true
            end
        end
    end
end)

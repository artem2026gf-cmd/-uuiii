local glowEnabled, glowWidth, glowStrength, glowOpacity = false, 12, 45, 55
local glowColor = Color3.fromRGB(255, 255, 255)
local glowRings = {}
for i = 1, 6 do
    local ring = Instance.new("Frame")
    ring.Name = "Glow" .. i
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.Position = UDim2.fromScale(0.5, 0.5)
    ring.BackgroundTransparency = 1
    ring.ZIndex = 1
    ring.Parent = circle
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = ring
    local line = Instance.new("UIStroke")
    line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    line.Parent = ring
    glowRings[i] = {frame = ring, stroke = line}
end
circle.ZIndex = 2
local function updateGlow()
    local count = #glowRings
    for i, entry in ipairs(glowRings) do
        local distance = (i - 0.5) * glowWidth / count
        entry.frame.Size = UDim2.new(1, distance * 2, 1, distance * 2)
        entry.frame.Visible = glowEnabled
        entry.stroke.Color = glowColor
        entry.stroke.Thickness = math.max(1, glowWidth / count + 1)
        local fraction = (i - 1) / count
        -- Strength controls how far the glow spreads; opacity controls visibility.
        local falloff = (1 - fraction) ^ (3.5 - 3 * glowStrength / 100)
        entry.stroke.Transparency = 1 - (glowOpacity / 100) * falloff
    end
end
updateGlow()

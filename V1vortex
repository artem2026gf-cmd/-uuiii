local function registerGradient(key, parent, first, second)
    local g = Instance.new("UIGradient")
    g.Enabled = false
    g.Parent = parent
    gradients[key] = {g = g, first = first, second = second, on = false}
end
registerGradient("line", stroke, lineColor, lineColor)
registerGradient("fill", circle, fillColor, fillColor)
registerGradient("outline", outlineStroke, outlineColor, outlineColor)
for i, entry in ipairs(glowRings) do registerGradient("glow" .. i, entry.stroke, glowColor, glowColor) end
local function applyGradient(key, primary)
    local v = gradients[key]
    v.first = primary
    v.g.Color = ColorSequence.new(primary, v.second)
    v.g.Enabled = v.on
end
local function refreshVisualColors()
    local line = targetColorEnabled and targetFound and targetColor or lineColor
    applyGradient("line", line)
    stroke.Color = gradients.line.on and Color3.new(1, 1, 1) or line
    applyGradient("fill", fillColor)
    circle.BackgroundColor3 = gradients.fill.on and Color3.new(1, 1, 1) or fillColor
    applyGradient("outline", outlineColor)
    outlineStroke.Color = gradients.outline.on and Color3.new(1, 1, 1) or outlineColor
    for i, entry in ipairs(glowRings) do
        local key = "glow" .. i
        applyGradient(key, glowColor)
        entry.stroke.Color = gradients[key].on and Color3.new(1, 1, 1) or glowColor
    end
end

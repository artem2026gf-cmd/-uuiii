local function warn(...)
    originalWarn(...)
    local first = tostring(select(1, ...))
    if first:find("[Silent]", 1, true) or first:find("[Box ESP]", 1, true) then
        local items = table.pack(...)
        local out = {}
        for i = 1, items.n do out[#out + 1] = tostring(items[i]) end
        showStartupError(table.concat(out, " "))
    end
end

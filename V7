local function desired()
local result = {}
if state.sunsetMode then
 result.ClockTime = 18
 result.Brightness = 2
 result.Ambient = Color3.fromRGB(112, 91, 98)
 result.OutdoorAmbient = Color3.fromRGB(165, 126, 112)
 result.ColorShift_Top = Color3.fromRGB(255, 158, 102)
 result.ColorShift_Bottom = Color3.fromRGB(73, 49, 75)

for _, key in ipairs({"ClockTime", "Brightness", "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom"}) do
local value = wanted[key]
local current = lighting[key]
if value ~= nil then
if saved[key] == nil then saved[key] = current
elseif last[key] ~= nil and current ~= last[key] then saved[key] = current end
if current ~= value then lighting[key] = value end
last[key] = value
elseif saved[key] ~= nil then
lighting[key] = saved[key]
saved[key] = nil
last[key] = nil
end
end
updateSunsetEffect()
end
state.updateSunsetLighting = apply
local protectedLights = {}
local mapConnection, mapAddedConnection, mapRemovingConnection
local protecting = false
local function releaseLights()
 for light, rec in pairs(protectedLights) do
  if rec.connection then rec.connection:Disconnect() end
  pcall(function() if light.Parent and light.Enabled ~= rec.desired then light.Enabled = rec.desired end end)
  protectedLights[light] = nil
 end
end
local function trackLight(light)
 if not protecting or protectedLights[light] or not (light:IsA("PointLight") or light:IsA("SpotLight") or light:IsA("SurfaceLight")) then return end
 if not light.Enabled then return end
 local rec = {desired=true, writing=false}
 protectedLights[light] = rec
 rec.connection = light:GetPropertyChangedSignal("Enabled"):Connect(function()
  if not protecting or rec.writing or not light.Parent then return end
  if not light.Enabled then
   rec.desired = false
   rec.writing = true
   light.Enabled = true
   rec.writing = false
  end
 end)
end
local function watchMap(map)
 if mapConnection then mapConnection:Disconnect(); mapConnection=nil end
 releaseLights()
 if not protecting or not map then return end

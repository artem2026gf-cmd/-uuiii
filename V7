  data = {category = category, material = part.Material, variant = part.MaterialVariant, color = part.Color, reflectance=part.Reflectance, transparency=part.Transparency, meshes = {}, decals = {}, surfaces = {}}
  if part:IsA("MeshPart") then local ok, value = pcall(function() return part.TextureID end); if ok then data.texture = value end end
  saved[part] = data
 end
 for _, child in ipairs(part:GetChildren()) do
  if child:IsA("SurfaceAppearance") then
   data.surfaces[child] = true
   pcall(function() child.Parent = nil end)
  elseif child:IsA("SpecialMesh") then
   if data.meshes[child] == nil then data.meshes[child] = child.TextureId end
   pcall(function() child.TextureId = "" end)
  elseif child:IsA("Decal") or child:IsA("Texture") then
   if data.decals[child] == nil then data.decals[child] = child.Transparency end
   pcall(function() child.Transparency = 1 end)
  end
 end
 if data.texture ~= nil then pcall(function() if part.TextureID ~= "" then part.TextureID = "" end end) end
 pcall(function() if part.MaterialVariant ~= "" then part.MaterialVariant = "" end end)
 pcall(function() local material = Enum.Material[cfg.material=="Chrome" and "Metal" or cfg.material=="Custom Glass" and "Glass" or cfg.material]; if material and part.Material ~= material then part.Material = material end end)
 pcall(function() if part.Color ~= cfg.color then part.Color = cfg.color end end)
 pcall(function()part.Reflectance=cfg.material=="Chrome" and .75 or cfg.material=="Custom Glass" and .12 or data.reflectance end)
 pcall(function()
  local current=part.Transparency
  if data.chamsTransparency ~= nil and current ~= data.chamsTransparency then
   data.transparency=current;data.chamsTransparency=nil

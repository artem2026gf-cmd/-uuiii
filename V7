end
local function restoreAppearances()
for item, parent in pairs(cfg.appearances) do
pcall(function() if item.Parent == nil and parent and parent:IsDescendantOf(workspace) then item.Parent = parent end end)
end
table.clear(cfg.appearances)
end
local function restoreAll()
restoreAppearances()
for item, values in pairs(cfg.saved) do
pcall(function()
if item:IsA("BasePart") then
item.Material = values.material
pcall(function() item.MaterialVariant = values.variant end)
item.Color = values.color
item.Reflectance = values.reflectance
if values.texture ~= nil then item.TextureID = values.texture end
elseif item:IsA("Decal") or item:IsA("Texture") then item.Transparency = values.transparency end
end)
end
table.clear(cfg.saved)
end
local function applyObject(item)
if not cfg.map or not item:IsDescendantOf(cfg.map) or isCharacter(item) then return end
if item:IsA("BasePart") then
if item.Transparency >= 1 and not cfg.saved[item] then return end
local old = cfg.saved[item]
if not old then
old = {material = item.Material, color = item.Color, reflectance = item.Reflectance}
pcall(function() old.variant = item.MaterialVariant end)
if item:IsA("MeshPart") then old.texture = item.TextureID end
cfg.saved[item] = old
end
item.Material = cfg.grey and Enum.Material.SmoothPlastic or old.material
pcall(function() item.MaterialVariant = cfg.grey and "" or old.variant end)
item.Color = cfg.grey and cfg.color or old.color
item.Reflectance = old.reflectance
if old.texture ~= nil then item.TextureID = cfg.grey and "" or old.texture end
elseif item:IsA("Decal") or item:IsA("Texture") then
local old = cfg.saved[item]
if not old then old = {transparency = item.Transparency}; cfg.saved[item] = old end
item.Transparency = cfg.grey and 1 or old.transparency
elseif item:IsA("SurfaceAppearance") and cfg.grey and item.Parent then
cfg.appearances[item] = item.Parent
item.Parent = nil
end
end
local function enqueue(item) cfg.queue[#cfg.queue + 1] = item end
local function refresh()
if not cfg.grey then restoreAppearances() end
if not cfg.map then return end
local ok, descendants = pcall(function() return cfg.map:GetDescendants() end)
if ok then for _, item in ipairs(descendants) do enqueue(item) end end
end
local function selectMap()
local current = workspace:FindFirstChild("Map")
if current == cfg.map then return end
if cfg.added then cfg.added:Disconnect(); cfg.added = nil end
restoreAll()
cfg.queue = {}; cfg.head = 1
cfg.map = current
if current then
cfg.added = current.DescendantAdded:Connect(function(item) enqueue(item) end)
refresh()
end
end
local function update()
if not cfg.grey then
if cfg.added then cfg.added:Disconnect(); cfg.added = nil end
restoreAll(); cfg.map = nil; cfg.queue = {}; cfg.head = 1
else
selectMap()
refresh()
if not cfg.map then pcall(function() ui:notify("Модель Workspace.Map не найдена; ожидаю карту", "warn", 4) end) end
end

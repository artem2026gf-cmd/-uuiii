for _,k in ipairs({"AuroraSoundV45","AuroraSoundV47","AuroraSoundV48","AuroraSoundV49","AuroraSoundV50","AuroraSoundFix","AuroraNameDistance","AuroraNameDistanceV50"})do
local a=G[k]
if a and a.Stop then pcall(a.Stop)end
G[k]=nil
end
for _,k in ipairs({"AuroraHubV3","AuroraHubV4","AuroraHubV41","AuroraHubV42","AuroraHubV43","AuroraHubV44","AuroraHubV45","AuroraHubV47","AuroraHubV48","AuroraHubV49","AuroraHubV50"})do
local a=G[k]
if a then
if a.Stop then pcall(function()a:Stop()end)end
if a.Window then pcall(function()a.Window:Destroy()end)end
end
G[k]=nil
end

local P=game:GetService("Players")
local W=game:GetService("Workspace")
local Run=game:GetService("RunService")
local LP=P.LocalPlayer
local PG=LP:WaitForChild("PlayerGui")

for _,v in ipairs(PG:GetChildren())do
if v.Name:find("AuroraVisualRender") or v.Name:find("AuroraNameDistance") or v.Name=="AuroraHubVisualsV3"then
v:Destroy()
end
end

local A={
Active=true,Ready=false,Connections={},
Boxes={},Bars={},Skeletons={},Registry={},
C={enabled=false,mode="corners",glow=false,glowTransparency=.9,filled=false,filledTransparency=.45,outline=false,outlineTransparency=.8},
HC={enabled=false,number=false,glow=false,glowTransparency=.8,outline=false,outlineTransparency=.5,width=4,gap=7,speed=12},
SK={enabled=false,glow=false,glowTransparency=.8,outline=false,outlineTransparency=.5,thickness=1,color="Ice Amethyst"},
SC={enabled=false,teamCheck=true,distance=60,life=3,merge=12,selfRange=16,playerRange=16,shotsOnly=false},
NC={enabled=false,glow=false,outline=false},
DC={enabled=false,glow=false,outline=false}
}
G.AuroraHubV50=A

local function rgb(r,g,b)return Color3.fromRGB(r,g,b)end
local dark=rgb(17,12,28)
local lavender=rgb(195,175,255)
local ice=rgb(165,225,255)

local boxColors=ColorSequence.new({
ColorSequenceKeypoint.new(0,rgb(125,100,235)),
ColorSequenceKeypoint.new(.5,lavender),
ColorSequenceKeypoint.new(1,ice)
})

local hpColors=ColorSequence.new({
ColorSequenceKeypoint.new(0,rgb(45,255,105)),
ColorSequenceKeypoint.new(.5,rgb(255,235,65)),
ColorSequenceKeypoint.new(1,rgb(255,55,75))
})

local gui=Instance.new("ScreenGui")
gui.Name="AuroraVisualRenderV50"
gui.IgnoreGuiInset=true
gui.ResetOnSpawn=false
gui.DisplayOrder=9999
gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
gui.Parent=PG
A.VisualGui=gui

local function frame(parent,z)
local f=Instance.new("Frame")
f.BorderSizePixel=0
f.BackgroundColor3=Color3.new(1,1,1)
f.ZIndex=z or 2
f.Parent=parent
return f
end

local function rect(f,x,y,w,h)
f.Position=UDim2.fromOffset(x,y)
f.Size=UDim2.fromOffset(w,h)
end

local function gradient(parent,colors,rotation)
local g=Instance.new("UIGradient")
g.Color=colors
g.Rotation=rotation or 0
g.Parent=parent
return g
end

local function stroke(parent,width,color)
local s=Instance.new("UIStroke")
s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
s.Thickness=width
s.Color=color
s.Parent=parent
return s
end

local function glow(parent,z)
local g=Instance.new("ImageLabel")
g.BackgroundTransparency=1
g.Image="rbxassetid://18245826428"
g.ImageColor3=lavender
g.ImageTransparency=.9
g.ScaleType=Enum.ScaleType.Slice
g.SliceCenter=Rect.new(21,21,79,79)
g.ZIndex=z
g.Parent=parent
return g
end

local function newBox()
local e={}
e.holder=frame(gui,2)
e.holder.BackgroundTransparency=1
e.holder.Visible=false
e.glow=glow(e.holder,1)
e.fill=frame(e.holder,2)
gradient(e.fill,boxColors,90)

e.full=frame(e.holder,4)
e.full.BackgroundTransparency=1
e.fullStroke=stroke(e.full,1,lavender)
gradient(e.fullStroke,boxColors)

e.outline=frame(e.holder,3)
e.outline.BackgroundTransparency=1
e.outlineStroke=stroke(e.outline,3,dark)

e.lines={}
for i=1,8 do
local back=frame(e.holder,3)
back.BackgroundColor3=dark
local front=frame(e.holder,4)
front.BackgroundColor3=i<=4 and lavender or ice
e.lines[i]={back,front}
end
return e
end

local function drawBox(e,x,y,w,h,fade)
local C=A.C
local full=C.mode=="full"
local length=math.max(4,math.floor(math.min(w,h)*.24+.5))
fade=fade or 0

rect(e.holder,x,y,w,h)
e.holder.Visible=true
rect(e.fill,0,0,w,h)
e.fill.Visible=C.filled
e.fill.BackgroundTransparency=math.clamp(C.filledTransparency+fade,0,1)

rect(e.glow,-12,-12,w+24,h+24)
e.glow.Visible=C.glow
e.glow.ImageTransparency=math.clamp(C.glowTransparency+fade,0,1)

rect(e.full,0,0,w,h)
e.full.Visible=full
e.fullStroke.Transparency=fade

rect(e.outline,0,0,w,h)
e.outline.Visible=full and C.outline
e.outlineStroke.Transparency=math.clamp(C.outlineTransparency+fade,0,1)

local q={
{0,0,length,1},{w-length,0,length,1},
{0,h-1,length,1},{w-length,h-1,length,1},
{0,0,1,length},{w-1,0,1,length},
{0,h-length,1,length},{w-1,h-length,1,length}
}

for i,v in ipairs(e.lines)do
local p=q[i]
local back,front=v[1],v[2]
front.Visible=not full
back.Visible=not full and C.outline
if not full then
rect(front,p[1],p[2],p[3],p[4])
rect(back,p[1]-1,p[2]-1,p[3]+2,p[4]+2)
front.BackgroundTransparency=fade
back.BackgroundTransparency=math.clamp(C.outlineTransparency+fade,0,1)
end
end
end

A.NewBox=newBox
A.DrawBox=drawBox

local function newBar()
local e={smooth=1}
e.holder=frame(gui,5)
e.holder.BackgroundTransparency=1
e.holder.Visible=false
e.glow=glow(e.holder,4)
e.back=frame(e.holder,5)
e.back.BackgroundColor3=dark
e.outline=stroke(e.back,1,dark)
e.clip=frame(e.back,6)
e.clip.BackgroundTransparency=1
e.clip.ClipsDescendants=true
e.fill=frame(e.clip,6)
gradient(e.fill,hpColors,90)

e.text=Instance.new("TextLabel")
e.text.BackgroundTransparency=1
e.text.TextColor3=lavender
e.text.TextStrokeColor3=dark
e.text.TextStrokeTransparency=.25
e.text.Font=Enum.Font.GothamBold
e.text.TextSize=11
e.text.ZIndex=8
e.text.Parent=e.holder
return e
end

local function drawBar(e,x,y,h,hp,maxhp,dt)
local H=A.HC
local ratio=math.clamp(hp/math.max(maxhp,1),0,1)
e.smooth=e.smooth+(ratio-e.smooth)*math.min(1,dt*H.speed)

local scale=math.clamp(h/110,.35,2)
local width=math.max(2,math.floor(H.width*scale+.5))
local gap=math.max(3,math.floor(H.gap*scale+.5))
local amount=math.floor(h*e.smooth+.5)

rect(e.holder,x-gap-width,y,width,h)
e.holder.Visible=true
rect(e.back,0,0,width,h)
e.outline.Enabled=H.outline
e.outline.Transparency=H.outlineTransparency
rect(e.clip,0,h-amount,width,amount)
rect(e.fill,0,-(h-amount),width,h)

local pad=math.max(4,math.floor(7*scale+.5))
rect(e.glow,-pad,-pad,width+pad*2,h+pad*2)
e.glow.Visible=H.glow
e.glow.ImageTransparency=H.glowTransparency

e.text.Visible=H.number
e.text.Text=tostring(math.floor(hp+.5))
e.text.TextSize=math.clamp(math.floor(11*scale+.5),9,16)
rect(e.text,-24,-19,48,17)
end

local function team(o)
if not o then return nil end
local t=o:GetAttribute("Team")
if t~=nil then return tostring(t)end
if o:IsA("Player") and o.Team then return o.Team.Name end
end

local function enemy(c,mine)
if c==LP.Character or c.Name==LP.Name then return false end
local pl=P:GetPlayerFromCharacter(c)
if pl==LP then return false end
local ct=team(c) or team(pl)
if mine and ct then return mine~=ct end
if pl then
if LP.Team and pl.Team then return LP.Team~=pl.Team end
return true
end
return c:GetAttribute("Bot")==true
end

local function health(c)
if c:GetAttribute("Dead")==true then return 0,100 end
local hum=c:FindFirstChildOfClass("Humanoid")
local hp=c:GetAttribute("Health")
local maxhp=c:GetAttribute("MaxHealth")
if typeof(hp)~="number"then hp=hum and hum.Health or 100 end
if typeof(maxhp)~="number"then maxhp=hum and hum.MaxHealth or 100 end
return hp,math.max(maxhp,1)
end

local function root(c)
return c and (
c:FindFirstChild("HumanoidRootPart")
or c:FindFirstChild("UpperTorso")
or c:FindFirstChild("LowerTorso")
or c:FindFirstChild("Torso")
or c:FindFirstChild("Head")
or c.PrimaryPart)
end

local function bounds(c,r)
local head=c:FindFirstChild("Head")
local foot=c:FindFirstChild("LeftFoot")
or c:FindFirstChild("RightFoot")
or c:FindFirstChild("Left Leg")
or c:FindFirstChild("Right Leg")

local top=head and head:IsA("BasePart")
and head.Position+Vector3.new(0,head.Size.Y*.65+.15,0)
or r.Position+Vector3.new(0,3,0)

local bottom=foot and foot:IsA("BasePart")
and foot.Position-Vector3.new(0,foot.Size.Y*.5+.1,0)
or r.Position-Vector3.new(0,3,0)

if top.Y-bottom.Y<2 then
top=r.Position+Vector3.new(0,3,0)
bottom=r.Position-Vector3.new(0,3,0)
end
return top,bottom
end

local function collect()
local result={}
local folder=W:FindFirstChild("Characters")
if folder then
for _,c in ipairs(folder:GetChildren())do
if c:IsA("Model")then result[c]=true end
end
else
for _,pl in ipairs(P:GetPlayers())do
if pl~=LP and pl.Character then result[pl.Character]=true end
end
end
return result
end

local function project(cam,top,bottom)
local t=cam:WorldToViewportPoint(top)
local b=cam:WorldToViewportPoint(bottom)
if t.Z<=0 or b.Z<=0 then return nil end

local h=math.abs(b.Y-t.Y)
local w=h*.575
local x=(t.X+b.X)*.5-w*.5
local y=math.min(t.Y,b.Y)
local size=cam.ViewportSize

if h<4 or x+w<0 or x>size.X or y+h<0 or y>size.Y then return nil end

return math.floor(x+.5),math.floor(y+.5),
math.max(3,math.floor(w+.5)),math.max(4,math.floor(h+.5))
end

A.Root=root
A.Team=team
A.Enemy=enemy
A.Health=health
A.Collect=collect
A.Project=project
A.Bounds=bounds

local skeletonColors={
["Ice Amethyst"]=lavender,
["Lavender"]=lavender,
["Ice Blue"]=ice,
["White"]=rgb(245,245,255),
["Pink"]=rgb(255,150,215),
["Mint"]=rgb(150,255,215)
}

local bonesR15={
{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},
{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},
{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},
{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}
}

local bonesR6={
{"Head","Torso"},{"Torso","Left Arm"},
{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}
}

local function newSkeleton()
local e={lines={}}
e.holder=frame(gui,8)
e.holder.BackgroundTransparency=1
e.holder.Size=UDim2.fromScale(1,1)

for i=1,14 do
local back=frame(e.holder,8)
back.BackgroundColor3=dark
back.AnchorPoint=Vector2.new(.5,.5)
local halo=frame(e.holder,9)
halo.BackgroundColor3=lavender
halo.AnchorPoint=Vector2.new(.5,.5)
local front=frame(e.holder,10)
front.AnchorPoint=Vector2.new(.5,.5)
e.lines[i]={back,halo,front}
end
return e
end

local function drawLine(f,a,b,t,col,trans)
local d=b-a
local length=d.Magnitude
if length<.5 then f.Visible=false return end
f.Visible=true
f.Position=UDim2.fromOffset((a.X+b.X)*.5,(a.Y+b.Y)*.5)
f.Size=UDim2.fromOffset(length,t)
f.Rotation=math.deg(math.atan2(d.Y,d.X))
f.BackgroundColor3=col
f.BackgroundTransparency=trans
end

local function drawSkeleton(e,c,cam)
local SK=A.SK
local color=skeletonColors[SK.color] or lavender
local t=SK.thickness
local points={}
local bones=c:FindFirstChild("UpperTorso") and bonesR15 or bonesR6

for _,pair in ipairs(bones)do
for _,name in ipairs(pair)do
if points[name]==nil then
local part=c:FindFirstChild(name)
if part and part:IsA("BasePart")then
local p=cam:WorldToViewportPoint(part.Position)
points[name]=p.Z>0 and Vector2.new(p.X,p.Y) or false
else
points[name]=false
end
end
end
end

local shown=0
for i,line in ipairs(e.lines)do
local pair=bones[i]
local back,halo,front=line[1],line[2],line[3]
if pair and points[pair[1]] and points[pair[2]]then
local a,b=points[pair[1]],points[pair[2]]
drawLine(front,a,b,t,color,0)
shown=shown+1
if SK.outline then
drawLine(back,a,b,t+2,dark,SK.outlineTransparency)
else
back.Visible=false
end
if SK.glow then
drawLine(halo,a,b,t+5,color,SK.glowTransparency)
else
halo.Visible=false
end
else
back.Visible=false
halo.Visible=false
front.Visible=false
end
end
e.holder.Visible=shown>0
end

local function remove(map,key)
local e=map[key]
if e then
e.holder:Destroy()
map[key]=nil
end
end

local function clear()
for c in pairs(A.Boxes)do remove(A.Boxes,c)end
for c in pairs(A.Bars)do remove(A.Bars,c)end
for c in pairs(A.Skeletons)do remove(A.Skeletons,c)end
end

local function render(dt)
if not A.Active then return end
local C,H,SK=A.C,A.HC,A.SK
if not C.enabled and not H.enabled and not SK.enabled then
clear()
return
end

local cam=W.CurrentCamera
if not cam then return end
local seen={}
local mine=team(LP) or team(LP.Character)

for c in pairs(collect())do
if c.Parent and enemy(c,mine)then
local hp,maxhp=health(c)
if hp>0 then
local r=root(c)
if r then
local top,bottom=bounds(c,r)
local x,y,w,h=project(cam,top,bottom)
if x then
seen[c]=true
if C.enabled then
local e=A.Boxes[c]
if not e then e=newBox()A.Boxes[c]=e end
drawBox(e,x,y,w,h)
end
if H.enabled then
local e=A.Bars[c]
if not e then e=newBar()A.Bars[c]=e end
drawBar(e,x,y,h,hp,maxhp,dt)
end
if SK.enabled then
local e=A.Skeletons[c]
if not e then e=newSkeleton()A.Skeletons[c]=e end
drawSkeleton(e,c,cam)
end
end
end
end
end
end

for c in pairs(A.Boxes)do
if not seen[c] or not C.enabled then remove(A.Boxes,c)end
end
for c in pairs(A.Bars)do
if not seen[c] or not H.enabled then remove(A.Bars,c)end
end
for c in pairs(A.Skeletons)do
if not seen[c] or not SK.enabled then remove(A.Skeletons,c)end
end
end

local lastError=0
A.Connections[#A.Connections+1]=Run.RenderStepped:Connect(function(dt)
local ok,err=pcall(render,dt)
if not ok and os.clock()-lastError>3 then
lastError=os.clock()
warn("[AURORA RENDER]",err)
end
end)

function A:Stop()
if not self.Active then return end
self.Active=false
for _,k in ipairs({"AuroraSoundV50","AuroraNameDistanceV50"})do
local mod=G[k]
if mod and mod.Stop then pcall(mod.Stop)end
end
for _,c in ipairs(self.Connections)do
pcall(function()c:Disconnect()end)
end
clear()
if self.VisualGui then self.VisualGui:Destroy()end
end

local src
if readfile then
for _,path in ipairs({"hub/windui.lua","windui.lua"})do
local ok,data=pcall(readfile,path)
if ok and type(data)=="string" and #data>100 then
src=data
break
end
end
end

if not src then
src=game:HttpGet("https://raw.githubusercontent.com/amazson/zaml/main/windui.lua",true)
if writefile then
pcall(function()
if makefolder and isfolder and not isfolder("hub")then makefolder("hub")end
writefile("hub/windui.lua",src)
end)
end
end


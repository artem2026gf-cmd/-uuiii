local query=""

search:Input({
Title="Search",
Placeholder="Type setting name...",
Callback=function(v)
query=tostring(v or ""):lower()
end
})

search:Button({
Title="Find and open",
Callback=function()
if query==""then return end
for _,entry in ipairs(Registry)do
if entry.title:lower():find(query,1,true)then
pcall(function()Window:SelectTab(entry.tab)end)
pcall(function()entry.tab:Select()end)
pcall(function()
if entry.obj.ScrollTo then entry.obj:ScrollTo()end
end)
return
end
end
warn("[AURORA HUB] Настройка не найдена: "..query)
end
})

A.Part2Loaded=true
print("[AURORA HUB] 2 часть загружена")
local G=getgenv and getgenv() or _G
local A=G.AuroraHubV50
if not A or not A.Active or not A.Ready then
warn("[AURORA SOUND] Сначала запусти часть 1")
return
end

if G.AuroraSoundV50 and G.AuroraSoundV50.Stop then
pcall(G.AuroraSoundV50.Stop)
end

local Players=game:GetService("Players")
local RS=game:GetService("RunService")
local HS=game:GetService("HttpService")
local Rep=game:GetService("ReplicatedStorage")
local W=game:GetService("Workspace")
local LP=Players.LocalPlayer

local S={Active=true,Marks={},Received=0,Accepted=0,Connected=false}
G.AuroraSoundV50=S

local markers=S.Marks
local lastSoundAt=0
local renderConn
local disconnect

local function eyePos()
local c=LP.Character
local h=c and c:FindFirstChild("Head")
local cam=W.CurrentCamera
return h and h.Position or cam and cam.CFrame.Position or Vector3.zero
end

local function isTeammate(p)
if p==LP then return true end
local t=p:GetAttribute("Team")
local mine=LP:GetAttribute("Team")
return (t=="Terrorists" or t=="Counter-Terrorists") and t==mine
end

local function whoFired(cls)
local found
for _,p in ipairs(Players:GetPlayers())do
if p~=LP and not isTeammate(p) and p:GetAttribute("Dead")==false then
local ch=p.Character
if not (ch and ch:IsDescendantOf(W))then
local raw=p:GetAttribute("CurrentEquipped")
local ok,decoded=pcall(HS.JSONDecode,HS,type(raw)=="string" and raw or "")
local weapon=ok and type(decoded)=="table" and decoded.Name or nil
if weapon and weapon==cls then
if found then return nil end
found=p.Name
end
end
end
end
return found
end

local function checkOwner(name)
if not name then return nil end
local p=Players:FindFirstChild(name)
if not p then return nil end
return not isTeammate(p)
end

local ignored={"Bomb","Plant","Defus","Killed","Music","Hostage","Round","Win"}

local function ignore(name)
for _,s in ipairs(ignored)do
if name:find(s,1,true)then return true end
end
return false
end

local function nearCharacter(pos)
local folder=W:FindFirstChild("Characters")
if not folder then return false end
for _,m in ipairs(folder:GetChildren())do
if m:IsA("Model")then
local r=m:FindFirstChild("HumanoidRootPart")
if r and (r.Position-pos).Magnitude<A.SC.playerRange then return true end
end
end
return false
end

local function remove(m)
if m.box then pcall(function()m.box.holder:Destroy()end)end
markers[m]=nil
end

local function count()
local n=0
for _ in pairs(markers)do n=n+1 end
return n
end

local function destroyOldest()
local oldest,oldestTime
for m in pairs(markers)do
if not oldestTime or m.last<oldestTime then
oldest=m
oldestTime=m.last
end
end
if oldest then remove(oldest)end
end

local function onSound(sound)
if not S.Active or not A.Active then return end
if not sound or type(sound)~="table"then return end

S.Received=S.Received+1
if not A.SC.enabled then return end

local now=os.clock()
if now-lastSoundAt<1/120 then return end
lastSoundAt=now

local pos=sound.Position
if typeof(pos)~="Vector3"then return end

local name=tostring(sound.Name or "")
if ignore(name)then return end

local isShot=name=="Shoot"
if A.SC.shotsOnly and not isShot then return end

local distance=(eyePos()-pos).Magnitude
if distance<A.SC.selfRange then return end
if distance>A.SC.distance/.28 then return end
if nearCharacter(pos)then return end

local cls=sound.Class
local who=isShot and whoFired(cls) or nil

if A.SC.teamCheck and who then
local result=checkOwner(who)
if result==false then return end
end

local nearest,nearestDistance
for m in pairs(markers)do
if m.pos then
local d=(m.pos-pos).Magnitude
if d<A.SC.merge and (not nearestDistance or d<nearestDistance)then
nearest=m
nearestDistance=d
end
end
end

local entry=nearest
if not entry then
if count()>=64 then destroyOldest()end
entry={}
markers[entry]=true
end

if entry.pos and entry.last and now-entry.last>.05
and now-entry.last<.5 and isShot==entry.wasShot then
local v=(pos-entry.pos)/(now-entry.last)
v=Vector3.new(v.X,0,v.Z)
entry.vel=v.Magnitude<32 and v or nil
else
entry.vel=nil
end

entry.wasShot=isShot
entry.pos=pos
entry.last=now
entry.who=who
S.Accepted=S.Accepted+1
end

local function connect()
local ok,remotes=pcall(function()
return require(Rep.Database.Security.Remotes)
end)

if not ok or not remotes then
warn("[AURORA SOUND] Remotes missing")
return false
end

local remote=remotes.Sound and remotes.Sound.ReplicateSound
if not remote then
warn("[AURORA SOUND] ReplicateSound missing")
return false
end

local success,result=pcall(function()
return remote.Connect(function(sound)
local valid,err=pcall(onSound,sound)
if not valid then warn("[AURORA SOUND EVENT]",err)end
end)
end)

if not success then
warn("[AURORA SOUND CONNECT]",result)
return false
end

if type(result)=="function"then
disconnect=result
elseif typeof(result)=="RBXScriptConnection"then
disconnect=function()result:Disconnect()end
elseif type(result)=="table" and type(result.Disconnect)=="function"then
disconnect=function()result:Disconnect()end
end
return true
end

local function render()
if not S.Active or not A.Active then return end

if not A.SC.enabled then
for m in pairs(markers)do remove(m)end
return
end

local cam=W.CurrentCamera
if not cam then return end
local now=os.clock()

for m in pairs(markers)do
local age=now-m.last
if age>A.SC.life then
remove(m)
else
local sinceUpdate=now-m.last
local pos=(m.vel and sinceUpdate<.5)
and m.pos+m.vel*math.min(sinceUpdate,.4)
or m.pos

local duplicate=false
if A.C.enabled then
for c,e in pairs(A.Boxes)do
if e.holder.Visible then
local r=A.Root(c)
if r and (r.Position-pos).Magnitude<8 then
duplicate=true
break
end
end
end
end

if duplicate then
if m.box then m.box.holder.Visible=false end
else
local x,y,w,h=A.Project(cam,pos+Vector3.new(0,5.5,0),pos)

if x then
if not m.box then m.box=A.NewBox()end
local fade=math.clamp(age/A.SC.life*.85,0,.85)
A.DrawBox(m.box,x,y,w,h,fade)
elseif m.box then
m.box.holder.Visible=false
end
end
end
end
end

local lastError=0
renderConn=RS.RenderStepped:Connect(function()
local ok,err=pcall(render)
if not ok and os.clock()-lastError>3 then
lastError=os.clock()
warn("[AURORA SOUND RENDER]",err)
end
end)

S.Connected=connect()

function S.Stop()
if not S.Active then return end
S.Active=false
if renderConn then pcall(function()renderConn:Disconnect()end)end
if disconnect then pcall(disconnect)end
for m in pairs(markers)do remove(m)end
end

S.TeleportConnection=LP.OnTeleport:Connect(function()
S.Stop()
end)

local oldStop=S.Stop
function S.Stop()
oldStop()
if S.TeleportConnection then
S.TeleportConnection:Disconnect()
S.TeleportConnection=nil
end
end

function S.Stats()
return {
connected=S.Connected,
received=S.Received,
accepted=S.Accepted,
marks=count(),
enabled=A.SC.enabled,
distance=A.SC.distance,
teamCheck=A.SC.teamCheck,
shotsOnly=A.SC.shotsOnly
}
end

print("[AURORA HUB] 3 часть загружена")
print("[AURORA SOUND] Connected:",S.Connected)
local G=getgenv and getgenv() or _G
local A=G.AuroraHubV50

if not A or not A.Active or not A.Ready then
warn("[AURORA NAME] Сначала запусти часть 1")
return
end

if G.AuroraNameDistanceV50 and G.AuroraNameDistanceV50.Stop then
pcall(G.AuroraNameDistanceV50.Stop)
end

local P=game:GetService("Players")
local W=game:GetService("Workspace")
local R=game:GetService("RunService")
local LP=P.LocalPlayer

local N={
Active=true,
Connections={},
Entries={},
Name=A.NC,
Distance=A.DC
}
G.AuroraNameDistanceV50=N

local lavender=Color3.fromRGB(195,175,255)
local ice=Color3.fromRGB(165,225,255)
local dark=Color3.fromRGB(17,12,28)

local gui=Instance.new("ScreenGui")
gui.Name="AuroraNameDistanceV50"
gui.IgnoreGuiInset=true
gui.ResetOnSpawn=false
gui.DisplayOrder=9998
gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
gui.Parent=LP:WaitForChild("PlayerGui")
N.Gui=gui

local function makeText(parent)
local holder=Instance.new("Frame")
holder.BackgroundTransparency=1
holder.BorderSizePixel=0
holder.Visible=false
holder.Parent=parent

local inner=Instance.new("TextLabel")
inner.BackgroundTransparency=1
inner.Font=Enum.Font.GothamBold
inner.TextSize=14
inner.TextColor3=ice
inner.TextTransparency=.78
inner.TextStrokeColor3=lavender
inner.TextStrokeTransparency=.8
inner.TextXAlignment=Enum.TextXAlignment.Center
inner.Size=UDim2.fromScale(1,1)
inner.ZIndex=2
inner.Parent=holder

local glow=Instance.new("TextLabel")
glow.BackgroundTransparency=1
glow.Font=Enum.Font.GothamBold
glow.TextSize=16
glow.TextColor3=ice
glow.TextTransparency=.65
glow.TextStrokeColor3=lavender
glow.TextStrokeTransparency=.7
glow.TextXAlignment=Enum.TextXAlignment.Center
glow.Size=UDim2.fromScale(1,1)
glow.ZIndex=2
glow.Parent=holder

local text=Instance.new("TextLabel")
text.BackgroundTransparency=1
text.Font=Enum.Font.GothamBold
text.TextSize=12
text.TextColor3=lavender
text.TextStrokeColor3=dark
text.TextStrokeTransparency=1
text.TextXAlignment=Enum.TextXAlignment.Center
text.Size=UDim2.fromScale(1,1)
text.ZIndex=3
text.Parent=holder

local outline=Instance.new("UIStroke")
outline.Color=dark
outline.Thickness=1
outline.Transparency=.2
outline.Parent=text
outline.Enabled=false

return {
holder=holder,
text=text,
inner=inner,
glow=glow,
outline=outline
}
end

local function newEntry()
local holder=Instance.new("Frame")
holder.BackgroundTransparency=1
holder.BorderSizePixel=0
holder.Size=UDim2.fromScale(1,1)
holder.Parent=gui

return {
holder=holder,
name=makeText(holder),
distance=makeText(holder)
}
end

local function displayName(c)
local pl=P:GetPlayerFromCharacter(c)
if pl then return pl.DisplayName or pl.Name end
return c.Name
end

local function drawText(e,x,y,w,h,value,cfg)
e.holder.Visible=true
e.holder.Position=UDim2.fromOffset(x,y)
e.holder.Size=UDim2.fromOffset(w,h)

e.text.Text=value
e.inner.Text=value
e.glow.Text=value

e.inner.Visible=true
e.glow.Visible=cfg.glow
e.outline.Enabled=cfg.outline

e.text.TextColor3=lavender
e.inner.TextColor3=ice
e.glow.TextColor3=ice
end

local function remove(c)
local e=N.Entries[c]
if e then
e.holder:Destroy()
N.Entries[c]=nil
end
end

local function render()
if not N.Active or not A.Active then return end

local NC=N.Name
local DC=N.Distance

if not NC.enabled and not DC.enabled then
for c in pairs(N.Entries)do remove(c)end
return
end

local cam=W.CurrentCamera
if not cam then return end

local seen={}
local mine=A.Team(LP) or A.Team(LP.Character)

for c in pairs(A.Collect())do
if c.Parent and A.Enemy(c,mine)then
local hp=A.Health(c)

if hp>0 then
local r=A.Root(c)
if r then
local top,bottom=A.Bounds(c,r)
local t=cam:WorldToViewportPoint(top)
local b=cam:WorldToViewportPoint(bottom)

if t.Z>0 and b.Z>0 then
local centerX=(t.X+b.X)*.5
local viewport=cam.ViewportSize

if centerX>=-100 and centerX<=viewport.X+100
and t.Y>=-100 and b.Y<=viewport.Y+100 then

seen[c]=true
local e=N.Entries[c]
if not e then
e=newEntry()
N.Entries[c]=e
end

if NC.enabled then
drawText(e.name,centerX-85,t.Y-23,170,19,displayName(c),NC)
else
e.name.holder.Visible=false
end

if DC.enabled then
local distance=(cam.CFrame.Position-r.Position).Magnitude*.28
drawText(e.distance,centerX-65,b.Y+5,130,18,
tostring(math.floor(distance+.5)).."m",DC)
else
e.distance.holder.Visible=false
end
end
end
end
end
end
end

for c in pairs(N.Entries)do
if not seen[c]then remove(c)end
end
end

local lastError=0
N.Connections[#N.Connections+1]=R.RenderStepped:Connect(function()
local ok,err=pcall(render)
if not ok and os.clock()-lastError>3 then
lastError=os.clock()
warn("[AURORA NAME DISTANCE]",err)
end
end)

function N.Stop()
if not N.Active then return end
N.Active=false
for _,c in ipairs(N.Connections)do
pcall(function()c:Disconnect()end)
end
for c in pairs(N.Entries)do remove(c)end
if N.Gui then N.Gui:Destroy()end
end

print("[AURORA HUB] 4 часть загружена")

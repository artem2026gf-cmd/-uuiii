local G=getgenv and getgenv() or _G
local A=assert(G.AuroraHubV531,"Сначала запусти часть 1")
assert(A.NewBox,"Сначала запусти часть 2")

local P=game:GetService("Players")
local R=game:GetService("RunService")
local Rep=game:GetService("ReplicatedStorage")
local Http=game:GetService("HttpService")
local LP=P.LocalPlayer

local S={Active=true,Marks={},Received=0,Accepted=0,Connected=false}
G.AuroraSoundV531=S

local ignoreNames={"Bomb","Plant","Defus","Killed","Music","Hostage","Round","Win"}
local lastSoundAt=0
local connection
local renderConnection

local function count()
local n=0
for _ in pairs(S.Marks)do n=n+1 end
return n
end

local function ownPosition()
local r=A.Root(LP.Character)
return r and r.Position
end

local function nearCharacter(pos)
local folder=workspace:FindFirstChild("Characters")
if not folder then return false end

for _,c in ipairs(folder:GetChildren())do
if c:IsA("Model")then
local r=c:FindFirstChild("HumanoidRootPart")
if r and (r.Position-pos).Magnitude<A.SC.playerRange then
return true
end
end
end

return false
end

local function whoFired(cls)
if type(cls)~="string"then return nil end

local found
local number=0
local mine=A.Team(LP.Character) or A.Team(LP)

for _,p in ipairs(P:GetPlayers())do
if p~=LP and p:GetAttribute("Dead")==false then
local ct=A.Team(p.Character) or A.Team(p)

if not mine or not ct or mine~=ct then
local character=p.Character

if not character or not character:IsDescendantOf(workspace)then
local equipped=p:GetAttribute("CurrentEquipped")

if type(equipped)=="string"then
local ok,data=pcall(Http.JSONDecode,Http,equipped)

if ok and type(data)=="table" and data.Name==cls then
found=p
number=number+1
end
end
end
end
end
end

if number==1 then return found end
return nil
end

local function isAlly(p)
if not p then return false end
local mine=A.Team(LP.Character) or A.Team(LP)
local other=A.Team(p.Character) or A.Team(p)
return mine~=nil and other~=nil and mine==other
end

local function remove(m)
if m.box then
m.box.holder:Destroy()
m.box=nil
end
S.Marks[m]=nil
end

local function onSound(sound)
S.Received=S.Received+1

if not S.Active or not A.SC.enabled then return end
if type(sound)~="table"then return end

local now=os.clock()
if now-lastSoundAt<1/120 then return end
lastSoundAt=now

local pos=sound.Position
if typeof(pos)~="Vector3"then return end

local name=tostring(sound.Name or "")
local cls=tostring(sound.Class or "")

for _,word in ipairs(ignoreNames)do
if name:lower():find(word:lower(),1,true)then return end
end

local own=ownPosition()
if not own then return end

local distance=(pos-own).Magnitude
if distance<A.SC.selfRange then return end
if distance>A.SC.distance/.28 then return end
if nearCharacter(pos)then return end

local owner=whoFired(cls)
if A.SC.teamCheck and owner and isAlly(owner)then return end

local nearest
local nearestDistance=A.SC.merge

for m in pairs(S.Marks)do
local d=(m.pos-pos).Magnitude
if d<nearestDistance then
nearest=m
nearestDistance=d
end
end

if nearest then
local dt=now-nearest.last

if dt>=.05 and dt<=.5 and nearest.name==name then
local velocity=(pos-nearest.pos)/dt
if velocity.Magnitude<32 then nearest.vel=velocity end
end

nearest.pos=pos
nearest.last=now
nearest.created=now
nearest.name=name
nearest.owner=owner
else
if count()>=64 then
local oldest
for m in pairs(S.Marks)do
if not oldest or m.created<oldest.created then oldest=m end
end
if oldest then remove(oldest)end
end

S.Marks[{
pos=pos,
last=now,
created=now,
name=name,
owner=owner,
vel=nil,
box=nil
}]=true
end

S.Accepted=S.Accepted+1
end

local function duplicate(pos)
if not A.C.enabled then return false end

for c,b in pairs(A.Boxes)do
if b and b.holder.Visible then
local r=A.Root(c)
if r and (r.Position-pos).Magnitude<8 then
return true
end
end
end

return false
end

local function render()
if not S.Active then return end

local cam=workspace.CurrentCamera
if not cam then return end

local now=os.clock()

for m in pairs(S.Marks)do
local age=now-m.created

if not A.SC.enabled or age>A.SC.life then
remove(m)
else
local since=now-m.last

local pos=(m.vel and since<.5)
and m.pos+m.vel*math.min(since,.4)
or m.pos

local x,y,w,h=A.Project(
cam,
pos+Vector3.new(0,5.5,0),
pos
)

if x and not duplicate(pos)then
if not m.box then m.box=A.NewBox()end
A.DrawBox(m.box,x,y,w,h,math.clamp(age/A.SC.life*.85,0,.85))
elseif m.box then
m.box.holder.Visible=false
end
end
end
end

local ok,err=pcall(function()
local remotes=require(Rep:WaitForChild("Database"):WaitForChild("Security"):WaitForChild("Remotes"))
local remote=remotes.Sound.ReplicateSound

connection=remote.Connect(function(sound)
local valid,message=pcall(onSound,sound)
if not valid then warn("[AURORA SOUND EVENT]",message)end
end)

S.Connected=true
end)

if not ok then warn("[AURORA SOUND CONNECT]",err)end

renderConnection=R.RenderStepped:Connect(function()
local valid,message=pcall(render)
if not valid then warn("[AURORA SOUND RENDER]",message)end
end)

function S.Stats()
return {
connected=S.Connected,
received=S.Received,
accepted=S.Accepted,
marks=count(),
enabled=A.SC.enabled,
distance=A.SC.distance,
teamCheck=A.SC.teamCheck
}
end

function S.Stop()
S.Active=false
if connection then
pcall(function()
if type(connection)=="function"then
connection()
elseif type(connection)=="table" and connection.Disconnect then
connection:Disconnect()
else
connection:Disconnect()
end
end)
end

if renderConnection then renderConnection:Disconnect()end
for m in pairs(S.Marks)do remove(m)end
end


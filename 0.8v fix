local G=getgenv and getgenv() or _G
local A=assert(G.AuroraHubV531,"Сначала запусти часть 1")

local P=game:GetService("Players")
local R=game:GetService("RunService")
local Http=game:GetService("HttpService")
local LP=P.LocalPlayer
local C3=Color3.fromRGB

local lavender=C3(195,175,255)
local ice=C3(165,225,255)
local dark=C3(17,12,28)

local N={
Active=true,
Connections={},
Entries={},
Name=A.NC,
Distance=A.DC,
Weapon=A.WC,
WeaponCache={}
}
G.AuroraTextV531=N

local gui=Instance.new("ScreenGui")
gui.Name="AuroraTextRenderV531"
gui.IgnoreGuiInset=true
gui.ResetOnSpawn=false
gui.DisplayOrder=9998
gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
gui.Parent=LP:WaitForChild("PlayerGui")
N.Gui=gui

local function label(parent,size,color,z)
local t=Instance.new("TextLabel")
t.BackgroundTransparency=1
t.BorderSizePixel=0
t.TextColor3=color
t.TextSize=size
t.Font=Enum.Font.GothamBold
t.TextXAlignment=Enum.TextXAlignment.Center
t.TextYAlignment=Enum.TextYAlignment.Center
t.TextTruncate=Enum.TextTruncate.AtEnd
t.ZIndex=z
t.Parent=parent
return t
end

local function makeText(parent)
local holder=Instance.new("Frame")
holder.BackgroundTransparency=1
holder.BorderSizePixel=0
holder.Parent=parent

local glow=label(holder,16,ice,1)
glow.Size=UDim2.fromScale(1,1)

local inner=label(holder,14,ice,2)
inner.Size=UDim2.fromScale(1,1)
inner.TextTransparency=.7

local text=label(holder,12,lavender,3)
text.Size=UDim2.fromScale(1,1)

local outline=Instance.new("UIStroke")
outline.Color=dark
outline.Thickness=1
outline.Transparency=.35
outline.Parent=text

return {
holder=holder,
glow=glow,
inner=inner,
text=text,
outline=outline
}
end

local function entry()
local holder=Instance.new("Frame")
holder.BackgroundTransparency=1
holder.BorderSizePixel=0
holder.Size=UDim2.fromOffset(1,1)
holder.Parent=gui

return {
holder=holder,
name=makeText(holder),
distance=makeText(holder),
weapon=makeText(holder)
}
end

local function updateText(obj,value,x,y,w,h,cfg,color)
obj.holder.Position=UDim2.fromOffset(x,y)
obj.holder.Size=UDim2.fromOffset(w,h)
obj.holder.Visible=true

obj.text.Text=value
obj.inner.Text=value
obj.glow.Text=value

obj.text.TextColor3=color or lavender
obj.inner.TextColor3=ice
obj.glow.TextColor3=color or ice

obj.glow.Visible=cfg.glow
obj.glow.TextTransparency=math.clamp(cfg.glowTransparency,0,1)

obj.outline.Enabled=cfg.outline
obj.outline.Transparency=math.clamp(cfg.outlineTransparency,0,1)
end

local function getName(c)
local player=P:GetPlayerFromCharacter(c)

if player then
local display=player.DisplayName
if type(display)=="string" and display~=""then return display end
return player.Name
end

return c.Name
end

local function getWeapon(c)
local player=P:GetPlayerFromCharacter(c)
if not player then
player=P:FindFirstChild(c.Name)
end
if not player or not player:IsA("Player")then return nil end

local raw=player:GetAttribute("CurrentEquipped")
if type(raw)~="string" or raw==""then return nil end

local cache=N.WeaponCache[player]
if cache and cache.raw==raw then return cache.name end

local ok,data=pcall(Http.JSONDecode,Http,raw)
local name

if ok and type(data)=="table" and type(data.Name)=="string"then
name=data.Name
end

N.WeaponCache[player]={raw=raw,name=name}
return name
end

local function remove(c)
local e=N.Entries[c]
if e then
e.holder:Destroy()
N.Entries[c]=nil
end
end

local function render()
if not N.Active or not A.Active then return end

local nc=A.NC
local dc=A.DC
local wc=A.WC

if not nc.enabled and not dc.enabled and not wc.enabled then
for c in pairs(N.Entries)do remove(c)end
return
end

local cam=workspace.CurrentCamera
if not cam then
for c in pairs(N.Entries)do remove(c)end
return
end

local mine=A.Team(LP.Character) or A.Team(LP)
local targets=A.Collect()
local visible={}

for c in pairs(targets)do
local ok,err=pcall(function()
if not A.Valid(c,mine)then return end

local top,bottom=A.Bounds(c)
if not top then return end

local x,y,w,h=A.Project(cam,top,bottom)
if not x then return end

visible[c]=true

local e=N.Entries[c]
if not e then
e=entry()
N.Entries[c]=e
end

local cx=x+w*.5

if nc.enabled then
updateText(
e.name,
getName(c),
math.floor(cx-85),
math.floor(y-23),
170,19,nc
)
else
e.name.holder.Visible=false
end

if dc.enabled then
local root=A.Root(c)
local meters=(cam.CFrame.Position-root.Position).Magnitude*.28
local value=tostring(math.floor(meters+.5)).."m"

updateText(
e.distance,
value,
math.floor(cx-65),
math.floor(y+h+5),
130,18,dc
)
else
e.distance.holder.Visible=false
end

if wc.enabled then
local weapon=getWeapon(c)

if weapon then
local offset=dc.enabled and 24 or 5
local color=A.Colors[wc.color] or lavender

updateText(
e.weapon,
weapon,
math.floor(cx-85),
math.floor(y+h+offset),
170,19,wc,color
)
else
e.weapon.holder.Visible=false
end
else
e.weapon.holder.Visible=false
end
end)

if not ok then
warn("[AURORA TEXT TARGET]",err)
visible[c]=nil
end
end

for c in pairs(N.Entries)do
if not visible[c]then remove(c)end
end
end

table.insert(N.Connections,R.RenderStepped:Connect(function()
local ok,err=pcall(render)
if not ok then warn("[AURORA TEXT RENDER]",err)end
end))

function N.Stop()
if not N.Active then return end
N.Active=false

for _,connection in ipairs(N.Connections)do
pcall(function()connection:Disconnect()end)
end

for c in pairs(N.Entries)do remove(c)end
table.clear(N.WeaponCache)

if N.Gui then
N.Gui:Destroy()
N.Gui=nil
end
end


local function root(c)
return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso"))
end

local function team(o)
if not o then return nil end
local t=o:GetAttribute("Team")
if t~=nil then return tostring(t)end
if o:IsA("Player") and o.Team then return o.Team.Name end
return nil
end

local function enemy(c,mine)
if not c or c==LP.Character or c.Name==LP.Name then return false end
local pl=P:GetPlayerFromCharacter(c)
if pl==LP then return false end
local ct=team(c) or team(pl)
if mine and ct then return mine~=ct end
if pl then
if LP.Team and pl.Team then return LP.Team~=pl.Team end
return true
end
return c:GetAttribute("Bot")==true
end

local function health(c)
local hp=c:GetAttribute("Health")
local max=c:GetAttribute("MaxHealth")
local hum=c:FindFirstChildOfClass("Humanoid")
if type(hp)~="number" and hum then hp=hum.Health end
if type(max)~="number" and hum then max=hum.MaxHealth end
hp=type(hp)=="number" and hp or 100
max=type(max)=="number" and max or 100
if c:GetAttribute("Dead")==true then hp=0 end
return hp,math.max(max,1)
end

local function collect()
local result={}
local folder=workspace:FindFirstChild("Characters")
if folder then
for _,c in ipairs(folder:GetChildren())do
if c:IsA("Model")then result[c]=true end
end
end
for _,pl in ipairs(P:GetPlayers())do
if pl~=LP and pl.Character and pl.Character.Parent==folder then
result[pl.Character]=true
end
end
return result
end

local function bounds(c)
local r=root(c)
if not r then return nil end
local head=c:FindFirstChild("Head")
local lf=c:FindFirstChild("LeftFoot") or c:FindFirstChild("Left Leg")
local rf=c:FindFirstChild("RightFoot") or c:FindFirstChild("Right Leg")
local foot=lf or rf
if lf and rf then foot=lf.Position.Y<rf.Position.Y and lf or rf end
local top=head and head.Position+Vector3.new(0,head.Size.Y*.65+.15,0) or r.Position+Vector3.new(0,3,0)
local bottom=foot and foot.Position-Vector3.new(0,foot.Size.Y*.5+.1,0) or r.Position-Vector3.new(0,3,0)
return top,bottom
end

local function project(cam,top,bottom)
local t=cam:WorldToViewportPoint(top)
local b=cam:WorldToViewportPoint(bottom)
if t.Z<=0 or b.Z<=0 then return nil end
local h=math.abs(b.Y-t.Y)
local w=h*.575
local x=(t.X+b.X)*.5-w*.5
local y=math.min(t.Y,b.Y)
local size=cam.ViewportSize
if h<4 or x+w<0 or x>size.X or y+h<0 or y>size.Y then return nil end
return math.floor(x+.5),math.floor(y+.5),math.max(3,math.floor(w+.5)),math.max(4,math.floor(h+.5))
end

local function valid(c,mine)
if not c or not c.Parent then return false end
local folder=workspace:FindFirstChild("Characters")
if folder and c.Parent~=folder then return false end
local hp=health(c)
return root(c)~=nil and hp>0 and enemy(c,mine)
end


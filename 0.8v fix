local function newBox()
local holder=F(A.VisualGui,lavender,2)
holder.BackgroundTransparency=1
holder.Visible=false
local fill=F(holder,purple,1)
fill.Size=UDim2.fromScale(1,1)
local grad=Instance.new("UIGradient")
grad.Color=ColorSequence.new({
ColorSequenceKeypoint.new(0,purple),
ColorSequenceKeypoint.new(.5,lavender),
ColorSequenceKeypoint.new(1,ice)
})
grad.Rotation=90
grad.Parent=fill
local full=F(holder,lavender,5)
full.BackgroundTransparency=1
full.Size=UDim2.fromScale(1,1)
local fs=Stroke(full,lavender,1)
local outline=F(holder,dark,3)
outline.BackgroundTransparency=1
outline.Size=UDim2.fromScale(1,1)
local os=Stroke(outline,dark,3)
local glow=F(holder,purple,2)
glow.BackgroundTransparency=1
glow.Size=UDim2.fromScale(1,1)
local gs=Stroke(glow,purple,5)
local seg={}
for i=1,8 do seg[i]=F(holder,lavender,6)end
return {holder=holder,fill=fill,full=full,fs=fs,outline=outline,os=os,glow=glow,gs=gs,seg=seg}
end

local function drawBox(b,x,y,w,h,fade)
local cfg=A.C
local alpha=math.clamp(fade or 0,0,1)
Pos(b.holder,x,y,w,h)
b.holder.Visible=true
b.fill.Visible=cfg.filled
b.fill.BackgroundTransparency=math.clamp(cfg.filledTransparency+alpha,0,1)
b.full.Visible=cfg.mode=="full"
b.fs.Transparency=alpha
b.outline.Visible=cfg.outline
b.os.Transparency=math.clamp(cfg.outlineTransparency+alpha,0,1)
b.glow.Visible=cfg.glow
b.gs.Transparency=math.clamp(cfg.glowTransparency+alpha,0,1)
local corners=cfg.mode~="full"
local l=math.max(3,math.floor(math.min(w,h)*.25))
for i=1,8 do
b.seg[i].Visible=corners
b.seg[i].BackgroundTransparency=alpha
end
local s=b.seg
Pos(s[1],0,0,l,1)
Pos(s[2],0,0,1,l)
Pos(s[3],w-l,0,l,1)
Pos(s[4],w-1,0,1,l)
Pos(s[5],0,h-1,l,1)
Pos(s[6],0,h-l,1,l)
Pos(s[7],w-l,h-1,l,1)
Pos(s[8],w-1,h-l,1,l)
end

A.NewBox=newBox

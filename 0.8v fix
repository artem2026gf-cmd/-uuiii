local function drawBar(b,x,y,w,h,hp,max,dt)
local cfg=A.HC
local scale=math.clamp(h/110,.35,2)
local bw=math.max(2,math.floor(cfg.width*scale+.5))
local gap=math.max(3,math.floor(cfg.gap*scale+.5))
local bx=x-gap-bw
Pos(b.outer,bx,y,bw,h)
Pos(b.clip,0,0,bw,h)
local ratio=math.clamp(hp/max,0,1)
b.smooth=b.smooth and b.smooth+(ratio-b.smooth)*math.clamp(dt*cfg.speed,0,1) or ratio
Pos(b.fill,0,math.floor(h*b.smooth+.5)-h,bw,h)
b.outline.Enabled=cfg.outline
b.outline.Transparency=cfg.outlineTransparency
b.glow.Enabled=cfg.glow
b.glow.Transparency=cfg.glowTransparency
b.text.Visible=cfg.number
b.text.Text=tostring(math.floor(hp+.5))
Pos(b.text,bx-49,y+math.floor(h*.5)-4,43,18)
b.outer.Visible=true
end

local bonesR15={

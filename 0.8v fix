{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}
}

local bonesR6={
{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
{"Torso","Left Leg"},{"Torso","Right Leg"}
}

local function newLines(n)
local lines={}
for i=1,n do
lines[i]={
back=F(A.VisualGui,dark,3),
halo=F(A.VisualGui,lavender,4),
front=F(A.VisualGui,lavender,5)
}
lines[i].back.Visible=false
lines[i].halo.Visible=false
lines[i].front.Visible=false
end
return lines
end

local function hideLines(lines)
for _,o in ipairs(lines)do
o.back.Visible=false
o.halo.Visible=false
o.front.Visible=false
end
end

local function drawSkeleton(lines,c,cam)
hideLines(lines)
local cfg=A.SK
local bones=c:FindFirstChild("UpperTorso") and bonesR15 or bonesR6
local color=A.Colors[cfg.color] or lavender
local size=cam.ViewportSize

for i,pair in ipairs(bones)do
local o=lines[i]
local a=c:FindFirstChild(pair[1])
local b=c:FindFirstChild(pair[2])

if a and b and a:IsA("BasePart") and b:IsA("BasePart")then
local pa=cam:WorldToViewportPoint(a.Position)
local pb=cam:WorldToViewportPoint(b.Position)

if pa.Z>0 and pb.Z>0 then
local va=Vector2.new(pa.X,pa.Y)
local vb=Vector2.new(pb.X,pb.Y)

local visible=(va.X>=0 and va.X<=size.X and va.Y>=0 and va.Y<=size.Y)
or (vb.X>=0 and vb.X<=size.X and vb.Y>=0 and vb.Y<=size.Y)

if visible then
A.Line(o.front,va,vb,cfg.thickness)
o.front.BackgroundColor3=color

if cfg.outline then
A.Line(o.back,va,vb,cfg.thickness+2)
o.back.BackgroundTransparency=cfg.outlineTransparency
end

if cfg.glow then
A.Line(o.halo,va,vb,cfg.thickness+5)
o.halo.BackgroundColor3=color
o.halo.BackgroundTransparency=cfg.glowTransparency
end
end
end
end
end
end

local function drawTracer(lines,cam,x,y,w,h)
hideLines(lines)
local cfg=A.TC
local size=cam.ViewportSize
local from=Vector2.new(size.X*.5,size.Y-2)
local to=Vector2.new(x+w*.5,y+h*.5)
local o=lines[1]
local color=A.Colors[cfg.color] or lavender

A.Line(o.front,from,to,1)
o.front.BackgroundColor3=color

if cfg.outline then
A.Line(o.back,from,to,3)
o.back.BackgroundTransparency=cfg.outlineTransparency
end

if cfg.glow then
A.Line(o.halo,from,to,6)
o.halo.BackgroundColor3=color
o.halo.BackgroundTransparency=cfg.glowTransparency
end
end

local function destroy(map,c)
local o=map[c]
if not o then return end

if o.holder then
o.holder:Destroy()
elseif o.outer then
o.outer:Destroy()
o.text:Destroy()
elseif o[1]then
for _,line in ipairs(o)do
line.back:Destroy()
line.halo:Destroy()
line.front:Destroy()
end
end

map[c]=nil
end

local function cleanup(map,visible,enabled)
for c in pairs(map)do
if not visible[c] or not enabled then
destroy(map,c)
end
end
end

local function render(dt)
if not A.Active then return end

local cam=workspace.CurrentCamera
if not cam then return end

local mine=A.Team(LP.Character) or A.Team(LP)
local targets=A.Collect()
local visible={}

for c in pairs(targets)do
local ok,err=pcall(function()
if not A.Valid(c,mine)then return end

local top,bottom=A.Bounds(c)
if not top then return end

local x,y,w,h=A.Project(cam,top,bottom)
if not x then return end

visible[c]=true
local hp,max=A.Health(c)

if A.C.enabled then
local b=A.Boxes[c]
if not b then
b=newBox()
A.Boxes[c]=b
end
drawBox(b,x,y,w,h)
end

if A.HC.enabled then
local b=A.Bars[c]
if not b then
b=newBar()
A.Bars[c]=b
end
drawBar(b,x,y,w,h,hp,max,dt)
end

if A.SK.enabled then
local b=A.Skeletons[c]
if not b then
b=newLines(14)
A.Skeletons[c]=b
end
drawSkeleton(b,c,cam)
end

if A.TC.enabled then
local b=A.Tracers[c]
if not b then
b=newLines(1)
A.Tracers[c]=b
end
drawTracer(b,cam,x,y,w,h)
end
end)

if not ok then
warn("[AURORA ESP TARGET]",err)
visible[c]=nil
end
end

cleanup(A.Boxes,visible,A.C.enabled)
cleanup(A.Bars,visible,A.HC.enabled)
cleanup(A.Skeletons,visible,A.SK.enabled)
cleanup(A.Tracers,visible,A.TC.enabled)
end

local connection=R.RenderStepped:Connect(function(dt)
local ok,err=pcall(render,dt)
if not ok then warn("[AURORA ESP RENDER]",err)end
end)

table.insert(A.Connections,connection)


local P=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local R=game:GetService("RunService")
local W=game:GetService("Workspace")
local LP=P.LocalPlayer

local S={
Active=true,Marks={},Connections={},
Received=0,Connected=false
}
G.AuroraSoundV45=S

local function req(...)
local n=RS
for _,s in ipairs({...})do
n=n and n:FindFirstChild(s)
if not n then return nil end
end
local ok,m=pcall(require,n)
return ok and m or nil
end

local Remotes=req("Database","Security","Remotes")
local Participants=req("Components","Common","Participants")
local Horde=req("Controllers","HordeController")

local function alive(c)
if not c or not c.Parent then return false end
if c:GetAttribute("Dead")==true then return false end
local hp=c:GetAttribute("Health")
if typeof(hp)=="number" and hp<=0 then return false end
local hum=c:FindFirstChildOfClass("Humanoid")
if hum and hum.Health<=0 then return false end
return true
end

local function enemies()
local list={}
local used={}
local mine=A.Team(LP) or A.Team(LP.Character)

local function add(c,owner,zombie)
if not c or not c:IsA("Model") or used[c] or not alive(c) then return end
if c==LP.Character or c.Name==LP.Name then return end
if zombie or A.Enemy(c,mine) then
used[c]=true
list[#list+1]=c
end
end

local folder=W:FindFirstChild("Characters")
if folder then
for _,c in ipairs(folder:GetChildren())do
if c:IsA("Model")then
add(c,P:GetPlayerFromCharacter(c))
end
end
end

for _,pl in ipairs(P:GetPlayers())do
if pl~=LP then add(pl.Character,pl)end
end

if Participants then
local ok,all=pcall(Participants.GetAll)
if ok and type(all)=="table"then
for _,inst in pairs(all)do
if typeof(inst)=="Instance"then
local ok2,c=pcall(Participants.Character,inst)
if ok2 and c then
local t=inst:GetAttribute("Team")
local mineTeam=A.Team(LP)

if t==nil or mineTeam==nil or tostring(t)~=mineTeam then
if not used[c] and alive(c)then
used[c]=true
list[#list+1]=c
end
end
end
end
end
end
end

if Horde then
local ok,all=pcall(Horde.GetLiveShells)
if ok and type(all)=="table"then
for _,c in pairs(all)do
if typeof(c)=="Instance" and c:IsA("Model")then
add(c,nil,true)
end
end
end
end

return list
end

local ignored={"Bomb","Plant","Defus","Killed","Music","Hostage","Round","Win"}

local function ignore(name)
for _,v in ipairs(ignored)do
if name:find(v,1,true)then return true end
end
return false
end

local function remove(i)
local m=S.Marks[i]
if m then
if m.box then m.box.holder:Destroy()end
table.remove(S.Marks,i)
end
end

local function onSound(info)
if not S.Active or not A.Active or not A.SC.enabled then return end
if type(info)~="table" then return end

local pos=info.Position
if typeof(pos)~="Vector3" then return end

local name=tostring(info.Name or "")
if ignore(name)then return end

local selfRoot=A.Root(LP.Character)
if selfRoot and (selfRoot.Position-pos).Magnitude<A.SC.selfRange then return end

S.Received=S.Received+1

local now=os.clock()
local best,dist

for _,m in ipairs(S.Marks)do
local d=(m.pos-pos).Magnitude
if d<A.SC.merge and (not dist or d<dist)then
best,dist=m,d
end
end

local m=best

if not m then
m={pos=pos,last=now}
S.Marks[#S.Marks+1]=m
else
local dt=now-m.last

if dt>.05 and dt<1.5 then
local v=(pos-m.pos)/dt
v=Vector3.new(v.X,0,v.Z)
m.velocity=v.Magnitude<32 and v or nil
else
m.velocity=nil
end
end

m.pos=pos
m.last=now
end

local remote=Remotes and Remotes.Sound and Remotes.Sound.ReplicateSound

local function connect()
if not remote then
warn("[AURORA SOUND] ReplicateSound missing")
return false
end

local ok,method=pcall(function()return remote.Connect end)

if ok and type(method)=="function"then
local success,result=pcall(method,function(info)
pcall(onSound,info)
end)

if success then
if type(result)=="function"then
S.Disconnect=result
elseif typeof(result)=="RBXScriptConnection"then
S.Disconnect=function()result:Disconnect()end
elseif type(result)=="table" and type(result.Disconnect)=="function"then
S.Disconnect=function()result:Disconnect()end
end
return true
end
end

if typeof(remote)=="Instance"then
local event

if remote:IsA("RemoteEvent")then
event=remote.OnClientEvent
elseif remote:IsA("BindableEvent")then
event=remote.Event
end

if event then
local c=event:Connect(function(info)
pcall(onSound,info)
end)

S.Disconnect=function()c:Disconnect()end
return true
end
end

return false
end

local function render()
if not S.Active or not A.Active then return end

if not A.SC.enabled then
for i=#S.Marks,1,-1 do remove(i)end
return
end

local cam=W.CurrentCamera
if not cam then return end

local now=os.clock()
local targets=enemies()

for i=#S.Marks,1,-1 do
local m=S.Marks[i]
local age=now-m.last

if age>A.SC.life then
remove(i)
else
local pos=m.velocity and
m.pos+m.velocity*math.min(age,.6) or m.pos

local nearest,dist

for _,c in ipairs(targets)do
local r=A.Root(c)

if r then
local d=(r.Position-pos).Magnitude

if not dist or d<dist then
nearest,dist=r,d
end
end
end

local duplicate=nearest and dist and dist<8

if duplicate and A.C.enabled then
if m.box then m.box.holder.Visible=false end
else
if nearest and dist and dist<12 then
pos=nearest.Position-Vector3.new(0,3,0)
end

local top=pos+Vector3.new(0,5.5,0)
local bottom=pos

local x,y,w,h=A.Project(cam,top,bottom)

if x then
if not m.box then m.box=A.NewBox()end
A.DrawBox(m.box,x,y,w,h,math.clamp(age/A.SC.life*.85,0,.85))
elseif m.box then
m.box.holder.Visible=false
end
end
end
end
end

local lastError=0

S.Connections[#S.Connections+1]=R.RenderStepped:Connect(function()
local ok,err=pcall(render)

if not ok and os.clock()-lastError>3 then
lastError=os.clock()
warn("[AURORA SOUND RENDER]",err)
end
end)

S.Connected=connect()

function S.Stop()
if not S.Active then return end
S.Active=false

for _,c in ipairs(S.Connections)do
pcall(function()c:Disconnect()end)
end

if S.Disconnect then pcall(S.Disconnect)end

for i=#S.Marks,1,-1 do remove(i)end
end

function S.Stats()
return {
connected=S.Connected,
received=S.Received,
marks=#S.Marks,
enabled=A.SC.enabled
}
end

print("[AURORA HUB] 3 часть загружена")
print("[AURORA SOUND] Connected:",S.Connected)
print("[AURORA SOUND] Bots:",Participants~=nil)
print("[AURORA SOUND] Horde:",Horde~=nil)
